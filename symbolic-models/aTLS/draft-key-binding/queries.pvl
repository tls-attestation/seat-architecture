(* Syntax highlighting: ocaml *)

(****************************************************************)
(*                                                              *)
(*  How to interpret results:                                   *)
(*                                                              *)
(****************************************************************)

(* 1. Authentication & Ordering (Correspondence Queries):
      event(Action) ==> event(Prerequisite)

   Asserts: If Action occurs, Prerequisite MUST have completed first.
   Pass condition: TRUE. Proves an attacker cannot reach Action alone.

   2. Reachability & Sanity Checks (Liveness Queries):
      query event('Happened')  [or: event('Happened') ==> false]

   Asserts: The hypothesis that 'Happened' CANNOT occur in any valid execution.
   Pass condition: FALSE ("RESULT not event('Happened') is false").
   Why: Proving this false demonstrates that the protocol can actually run 
   to completion. It guards against "vacuous truth," where a broken, deadlocked 
   protocol appears secure only because no events ever execute.

   3. Confidentiality (Secrecy Queries):
      query attacker(Secret)

   Asserts: The attacker never learns Secret.
   Pass condition: TRUE ("RESULT not attacker(Secret) is true").
   Why: Confirms there is no execution path leaking the designated term.
*)

(***********************************************************************)
(* Sanity Checks *)
(**********************************************************************)
(* Property: Event Reachability
Goal: confirm every event listed below actually fires on some run, so a
  "false" result elsewhere isn't silently vacuous.

Interpretation of result: none of these events are dead code; results
  elsewhere that build on them are meaningful.
*)
query cr:random, sr:random, ID_S,ID_C:identity,
      psk:preSharedKey, pubTSK,pubAK,pubKAK,pubRVP:pubkey, e:bitstring,
      offer:params, mode:params, ev,pat,kat,log,rdata:bitstring,
      kc:ae_key,ks:ae_key,ems:bitstring,rms:bitstring,
      idS, idXS: identity, kem_ss:bitstring, dev_state: measurements,
      ev_attr:attribute;

(* should be false (confirms both events are reachable) 
i.e., there exists a trace where *both* ServerID and ClientID 
are reachable with a shared/common kem_ss *)
    (event(ServerID(idS,kem_ss)) &&
     event(ClientID(idXS,kem_ss)));

    event(Accepted((pat,kat)));
    event(Appraised(log));
    event(ClientConn((pat,kat)));
    event(ClientFinished(pubTSK,psk,cr,sr,offer,mode,kc,ks,ems,rms));
    event(ClientFinRecentAgr(ID_S,ID_C,pubTSK,psk,offer,mode,kc,ks,ems,rms,cr,sr));
    event(ServerFinished(cr,sr,psk,pubTSK,offer,mode,kc,ks,ems,rms));
    event(ClientRANew(NULL_ID,NULL_pubkey,pubAK,pubKAK,pubTSK,pubRVP,dev_state,(pat,kat)));
    event(ClientFin1WayAgr(ID_S,pubTSK,psk,offer,mode,kc,ks,ems,rms));
    event(ProvisionedTargetEnv(ID_S, pubAK, pubTSK, dev_state));
    event(ClientStateEvKc((pat,kat), kc));
    event(AcceptedRdata(dev_state));
    event(EvidenceOracle(pubKAK, dev_state, pat));
    event(ServerAssertsProvenance(cr,sr,ev_attr));
    event(ClientAcceptsProvenance(cr,sr,ev_attr,pubKAK)) ==> false.

(* Property: Honest-Path Reachability
Goal: two honest-completion milestones -- reaching app-data exchange,
  and completing RA + 1-way TLS agreement -- are each reachable without
  needing any attack/weakness disjunct.

Events: (1) ClientReceivesAppData && ServerSendsAppData &&
  ProvisionedTargetEnv; (2) ClientRANew && ClientFin1WayAgr &&
  ClientStateEvKc && ProvisionedTargetEnv.

Parameters (of agreement): full session state on each side (ID, pubTSK,
  pubAK, pubKAK, cr, sr, req_ctx/ev, ems, ks, kc, dev_state[, app_msg]) -- so
  "honest" means the same session throughout, not two unrelated runs.
Method: LHS is the honest-completion predicate; RHS lists every
  weakness/compromise event the model can produce.

Formalization: LHS ==> RHS(all weaknesses), for each milestone.
Result: false for both, all 4 logs.
Interpretation of result: the happy path is real and doesn't secretly
  require an attack event to complete.
*)

query dev_state:measurements,quote:bitstring,
      cr:random, sr:random, cr':random, sr':random,
      ID,ID_C:identity,pubTSK,pubAK,pubKAK:pubkey,
      psk:preSharedKey, pubCA,pubCSP,pubRVP:pubkey,
      offer:params, mode:params, ev,pat,kat:bitstring,
      kc:ae_key,ks:ae_key,ems:bitstring,rms:bitstring,
      req_ctx,app_msg:bitstring,e:bitstring;

      ( event(ClientReceivesAppData(ID,pubTSK,pubKAK,cr,sr,req_ctx,ems,ks,kc,dev_state,app_msg))
        && event(ServerSendsAppData(ID,pubTSK,pubKAK,cr,sr,req_ctx,ems,ks,kc,dev_state,app_msg))
      ) && event(ProvisionedTargetEnv(ID, pubAK, pubTSK, dev_state)) 
      ==> 
         event(ClientAcceptsProvenance(cr, sr, ExternalOrUntrusted, pubKAK)) 
      || event(ServerAssertsProvenance(cr, sr, ExternalOrUntrusted)) 
      || event(ClientAcceptsKEM(cr, WeakKEM))   (* Tag: Q-DOWNGRADE [seat-use-cases-01 §3 ¶3, RFC 9846 App. F] *)
      || event(ClientAcceptsHash(cr, WeakHash)) 
      || event(LeakedAK(pubAK)) 
      || event(LeakedTSK(pubTSK)) 
      || event(LeakedKAK(pubKAK))
      || event(CompromisedCA(pubCA)) 
      || event(CompromisedCSP(pubCSP)) 
      || event(InvalidPolicies(pubRVP)) 
      || event(EvidenceOracle(pubKAK, dev_state, pat))
;

    (* -- second milestone (RA + 1-way agreement): see Property above -- *)
      ( event(ClientRANew(NULL_ID,NULL_pubkey,pubAK,pubKAK,pubTSK,pubRVP,dev_state,(pat,kat)))
        && event(ClientFinRecentAgr(ID,ID_C,pubTSK,psk,offer,mode,kc,ks,ems,rms,cr,sr))
        && event(ClientStateEvKc((pat,kat), kc)) 
      ) && event(ProvisionedTargetEnv(ID, pubAK, pubTSK, dev_state))
      ==>
         event(ClientAcceptsProvenance(cr, sr, ExternalOrUntrusted, pubKAK)) 
      || event(ServerAssertsProvenance(cr, sr, ExternalOrUntrusted)) 
      || event(ClientAcceptsKEM(cr, WeakKEM))
      || event(ClientAcceptsHash(cr, WeakHash)) 
      || event(LeakedAK(pubAK)) 
      || event(LeakedTSK(pubTSK)) 
      || event(LeakedKAK(pubKAK))
      || event(CompromisedCA(pubCA)) 
      || event(CompromisedCSP(pubCSP)) 
      || event(InvalidPolicies(pubRVP)) 
      || event(EvidenceOracle(pubKAK, dev_state, pat))
.

(**********************************************************************)
(* Binding and correlation queries [seat-use-cases-01 §4.1, §3.3.2] *)
(* Tag: Q-RELAY *)
(**********************************************************************)

(* Property: State Reachability (kem_ss / kch / kc)
Goal: Client and Server can land on the same evidence ev with matching
  kem_ss / kch / kc at all -- a prerequisite for the binding properties
  that follow.

Events: ClientStateEv/ServerStateEv (L1: kem_ss), ClientStateEvKch/
  ServerStateEvKch (L2: kch), ClientStateEvKc/ServerStateEvKc (L3: kc).

Parameters (of agreement): ev (shared evidence identifier), and the
  session-key term itself at each of the three points.

Method: bare conjunction of two events, no ==>; checked as reachability.
Formalization: `event(A) && event(B).`

Result: true (reachable), all 3 sub-queries, all 4 logs.
Interpretation of result: the binding properties below aren't testing
  an empty trace set.
*)
query ev,ev1,ev2,kem_ss,kem_ss1,kem_ss2,pat,kat:bitstring, 
      kch,kch1,kch2,ks,kc,kc1,kc2:ae_key,
      cr,sr,cr',sr':random,ID1,ID2,ID,ID_C:identity,
      pubAK,pubCA,pubTSK,pubTSK1,pubTSK2:pubkey,e:bitstring, 
      psk:preSharedKey,ems,rms:bitstring,
      dev_state,dev_state1,dev_state2:measurements,
      req_ctx,app_msg:bitstring,
      offer:params, mode:params;

      event(ClientStateEv(ev,kem_ss)) &&
      event(ServerStateEv(ev,kem_ss))
;

      event(ClientStateEvKch(ev,kch)) &&
      event(ServerStateEvKch(ev,kch))
;

      event(ClientStateEvKc(ev,kc)) &&
      event(ServerStateEvKc(ev,kc))
;

      event(ClientComp(ID,psk,offer,mode,kc,ks,ems,rms,cr,sr,pubTSK,dev_state)) &&
      event(ClientStateEvKc((pat,kat), kc)) 
  &&
      event(PreServerComp(ID,psk,offer,mode,kc,ks,ems,cr,sr,pubTSK,dev_state)) &&
      event(ServerStateEvKc((pat,kat), kc))
.

(**********************************************************************)
(* Binding *)
(*
Goal: Evidence should not be usable in other TLS sessions, even between
  the same endpoints (not bound to endpoints -- multiple sessions
  between the same two endpoints are possible).

Events: ClientStateEv/ServerStateEv, and the kch/kc analogues at two
  later points in the handshake.

Parameters (of agreement): ev (shared evidence) plus the session term at
  each level -- server identity is deliberately excluded here (covered
  separately by Server Identity + Key Correspondence and G-TLS1 below).

Method: three increasingly late binding points, in order:
  L1. kem_ss (up to the (EC)DHE exchange)
  L2. kch (up to ServerHello)
  L3. kc (up to ServerFinished)
  L1 <= L2 <= L3 -- if they see the same evidence, they should be in the
  same session.

Formalization: event(ClientStateEv*(ev,X)) && event(ServerStateEv*(ev,Y))
  ==> X = Y. Trace should never contain matching ev with differing X/Y.
*)
query ev,ev1,ev2,kem_ss,kem_ss1,kem_ss2:bitstring, 
      kch,kch1,kch2,ks,kc,kc1,kc2:ae_key,
      cr,sr,cr',sr':random,ID1,ID2,ID,ID_C:identity,
      pubAK,pubCA,pubTSK,pubTSK1,pubTSK2:pubkey,e:bitstring, 
      psk:preSharedKey,ems,rms:bitstring,
      dev_state,dev_state1,dev_state2:measurements,
      req_ctx,app_msg:bitstring,
      offer:params, mode:params;

(* G1 (kem_ss). Result: true, all 4 logs. *)
      event(ClientStateEv(ev,kem_ss1)) &&
      event(ServerStateEv(ev,kem_ss2)) ==>
      (kem_ss1 = kem_ss2)
;

(* G2 (kch). Result: true, all 4 logs. *)
      event(ClientStateEvKch(ev,kch1)) &&
      event(ServerStateEvKch(ev,kch2)) ==>
      (kch1 = kch2)
;

(* G3 (kc), with BadElement disjunct. Result: true, all 4 logs. *)
      event(ClientStateEvKc(ev,kc1)) &&
      event(ServerStateEvKc(ev,kc2)) ==>
      (kc1 = kc2) 
;
     
     (
       event(ClientComp(ID,psk,offer,mode,kc1,ks,ems,rms,cr,sr,pubTSK,dev_state)) &&
       event(ClientStateEvKc(ev1,kc1)) 
     )
         && (* Correlation *)
     (
       event(PreServerComp(ID,psk,offer,mode,kc2,ks,ems,cr,sr,pubTSK,dev_state)) &&
       event(ServerStateEvKc(ev2,kc2))
     ) ==> ((kc1,ev1) = (kc2,ev2))
.

(**********************************************************************)
(* Server Identity + Key Correspondence [seat-use-cases-01 §4.2] *)
(* Tag: Q-COMPOUND *)
(**********************************************************************)
query ID1,ID2:identity, kem_ss,ev,pat,kat:bitstring, dev_state:measurements, kc1,kc2:ae_key,
      cr:random, sr:random, pubTSK,pubAK,pubCA,pubCSP,pubRVP:pubkey;

     (
          event(ClientID(ID1, kem_ss)) 
       && event(ClientStateEv(ev, kem_ss)) 
       && event(ClientStateEvKc(ev, kc1))
     )
          && (* Correlation *)
     (
          event(ServerID(ID2, kem_ss)) 
       && event(ServerStateEv(ev, kem_ss)) 
       && event(ServerStateEvKc(ev, kc2))
     ) ==> ((ID1,kc1) = (ID2,kc2))
.
(**********************************************************************)
(* Attestation Signing Oracle Abuse [draft-reddy-rats-key-binding-02 §8.3] *)
(* Tag: Q-ORACLE *)
(**********************************************************************)

(* Demonstrated property:

EvidenceOracle is distinct from LeakedAK/LeakedKAK/LeakedTSK throughout this
file; it models a TEE-bound proxy that forwards fabricated claims on behalf 
of an untrusted caller, producing valid signatures without key exposure.

Rejection of oracle-manufactured credentials holds only under strict
provenance validation (ClientAcceptsProvenance = TrustedNonExportable).
Under loose validation (ExternalOrUntrusted), the oracle succeeds.
*)

query dev_state,dev_state1,dev_state2:measurements,quote:bitstring,
      cr:random, sr:random, cr':random, sr':random, kem_ss:bitstring,
      ID,ID2,EUID,ID_C:identity,pubTSK:pubkey,pubAK,pubKAK:pubkey,
      psk:preSharedKey, e:bitstring, pubRVP,pubCA,pubCSP:pubkey,
      offer:params, mode:params, pat,kat:bitstring,
      kc:ae_key,ks:ae_key,kch,ksh:ae_key,ems:bitstring,rms:bitstring;

(* Goal: Prove EvidenceOracle can interact with the same session as honest participants *)

(*  Hypothesis: The EvidenceOracle can never share matching tokens, measurements or otherwise
                participate with a legitimate handshake between two honest peers.
      Expected: true when RP/Client can discern between acceptable and non-acceptable Evidence.
        Branch: A+B
Interpretation: The Evidence Oracle is an active, coexisting threat 
  *)
  event(EvidenceOracle(pubKAK, dev_state, pat)) &&
  (    
       event(ClientRANew(NULL_ID, NULL_pubkey, pubAK, pubKAK, pubTSK, pubRVP, dev_state, (pat, kat)))
    && event(ClientFinRecentAgr(ID,ID_C,pubTSK,psk,offer,mode,kc,ks,ems,rms,cr,sr))
    && event(ClientStateEvKc((pat,kat), kc))
    && event(ProvisionedTargetEnv(ID, pubAK, pubTSK, dev_state)) 
    && event(ClientAcceptsProvenance(cr, sr, TrustedNonExportable, pubKAK))
  ) ==> false
;

  (* Hypothesis: The EvidenceOracle can never share matching tokens, measurements or otherwise
                 participate with a legitimate handshake between two honest peers.
     Expected: counterexample (false) when RP/Client does not scrutinize Evidence metadata.
     Branch: A+B
     Interpretation: The Evidence Oracle is an active, coexisting threat 
  *)
  event(EvidenceOracle(pubKAK, dev_state, pat)) &&
  (    
       event(ClientRANew(NULL_ID, NULL_pubkey, pubAK, pubKAK, pubTSK, pubRVP, dev_state, (pat, kat)))
    && event(ClientFinRecentAgr(ID,ID_C,pubTSK,psk,offer,mode,kc,ks,ems,rms,cr,sr))
    && event(ClientStateEvKc((pat,kat), kc))
    && event(ProvisionedTargetEnv(ID, pubAK, pubTSK, dev_state)) 
    && event(ClientAcceptsProvenance(cr, sr, ExternalOrUntrusted, pubKAK))
  ) ==> false
.

(**********************************************************************)
(* Target Environment Engagement [seat-use-cases-01 §3.8.1, §3.4] *)
(* Tag: Q-DIVERSION / Q-SUBST *)
(**********************************************************************)

(* Demonstrated property: 

The correspondence query formalizes that a TLS session key terminates inside a 
genuine, specific execution state by proving that when a client accepts both the 
TLS handshake and the composite attestation token (PAT and KAT) bound to the session 
keys (or trusts a webPKI CA equivalent), the resulting environment is authentic: 
UNLESS an entity within the __distributed trust perimeter__ is compromised.

In each case, the TLS signing key (TSK) is NOT considered confidential!
*)
query ID,ID_C: identity, pubTSK,pubKAK: pubkey, psk: preSharedKey, offer, mode: params,
    kc, ks: ae_key, ems, rms: bitstring, cr, sr: random, pat,kat: bitstring, dev_state: measurements,
    pubAK, pubCA, pubCSP, pubRVP: pubkey, ev_attr: attribute;

  (* Hypothesis: We can be made assured of an enclave's identity even when the Attestation Key is compromised
     Expected false when AK is leaked.
     Branch: A+B
     Interpretation: A trust assumption for the security of the Attestation Key is mandatory when considering enclave identity 
  *)
  ( event(ClientRANew(NULL_ID, NULL_pubkey, pubAK, pubKAK, pubTSK, pubRVP, dev_state, (pat,kat)))
    && event(ClientFinRecentAgr(ID,ID_C,pubTSK,psk,offer,mode,kc,ks,ems,rms,cr,sr))
    && event(ClientStateEvKc((pat,kat), kc))
  ) ==> event(ProvisionedTargetEnv(ID, pubAK, pubTSK, dev_state)) 
      || event(CompromisedCA(pubCA)) (* Req. for B only *)
      || event(CompromisedCSP(pubCSP)) (* Req. for A+B *)
      || event(InvalidPolicies(pubRVP)) (* Always req. to resist EvidenceOracle compromise *)
      (* || event(LeakedAK(pubAK)) *) (* Keeping `LeakedAK` off RHS disjunct simulates compromise such as TEE.fail *)
      || event(LeakedKAK(pubKAK)) (* Req. for A only *)
      || event(LeakedTSK(pubTSK)) (* Can be leaked in isolation for A or B *)
      || event(ClientAcceptsProvenance(cr,sr,ExternalOrUntrusted,pubKAK)) (* restrict metadata to The Good Kind (TM) *)
      || event(EvidenceOracle(pubKAK, dev_state, pat)) (* Do not analyze branches where the signing Oracle is active *)
;

  (* Hypothesis: We can be made assured of an enclave's identity without requiring CA trust.
     Expected A: true 
     Expected B: counterexample (false)
  *)
  ( event(ClientRANew(NULL_ID, NULL_pubkey, pubAK, pubKAK, pubTSK, pubRVP, dev_state, (pat,kat)))
    && event(ClientFinRecentAgr(ID,ID_C,pubTSK,psk,offer,mode,kc,ks,ems,rms,cr,sr))
    && event(ClientStateEvKc((pat,kat), kc))
  ) ==> event(ProvisionedTargetEnv(ID, pubAK, pubTSK, dev_state)) 
      (* || event(CompromisedCA(pubCA)) *) (* Req. for B only *)
      || event(CompromisedCSP(pubCSP)) (* Req. for A+B *)
      || event(InvalidPolicies(pubRVP)) (* Always req. to resist EvidenceOracle compromise *)
      || event(LeakedAK(pubAK)) (* Assumption that AK is secure is ALWAYS mandatory *)
      || event(LeakedKAK(pubKAK)) (* Req. for A only *)
      (* || event(LeakedTSK(pubTSK)) *) (* The TLS signing itself does not need to be confidential *)
      (* || event(EvidenceOracle(pubKAK, dev_state, pat)) *) (* Do not constrain the Evidence Oracle *)
;

  (* Hypothesis: We can be made assured of an enclave's FQDN identity by relying on CA trust without the key attestation key.
     Expected A: counterexample (false)
     Expected B: true
  *)
  ( event(ClientRANew(NULL_ID, NULL_pubkey, pubAK, pubKAK, pubTSK, pubRVP, dev_state, (pat,kat)))
    && event(ClientFinRecentAgr(ID,ID_C,pubTSK,psk,offer,mode,kc,ks,ems,rms,cr,sr))
    && event(ClientStateEvKc((pat,kat), kc))
  ) ==> event(ProvisionedTargetEnv(ID, pubAK, pubTSK, dev_state)) 
      || event(CompromisedCA(pubCA)) (* Req. for B only *)
      || event(CompromisedCSP(pubCSP)) (* Req. for A+B *)
      || event(InvalidPolicies(pubRVP)) (* Always req. to resist EvidenceOracle compromise *)
      || event(LeakedAK(pubAK)) (* Assumption that AK is secure is ALWAYS mandatory *)
      (* || event(LeakedKAK(pubKAK)) *) (* Req. for A only *)
      (* || event(LeakedTSK(pubTSK)) *) (* The TLS signing itself does not need to be confidential *)
      (* || event(EvidenceOracle(pubKAK, dev_state, pat)) *) (* Do not constrain the Evidence Oracle *)
;

  (* 
     Hypothesis: We can be made assured of an enclave's identity under EvidenceOracle threat without policy validation
     Expected: false when InvalidPolicies is not accounted for
     Branch: A+B
  *)
  ( event(ClientRANew(NULL_ID, NULL_pubkey, pubAK, pubKAK, pubTSK, pubRVP, dev_state, (pat,kat)))
    && event(ClientFinRecentAgr(ID,ID_C,pubTSK,psk,offer,mode,kc,ks,ems,rms,cr,sr))
    && event(ClientStateEvKc((pat,kat), kc))
  ) ==> event(ProvisionedTargetEnv(ID, pubAK, pubTSK, dev_state)) 
      || event(CompromisedCA(pubCA)) (* Req. for B only *)
      || event(CompromisedCSP(pubCSP)) (* Req. for A+B *)
      (* || event(InvalidPolicies(pubRVP)) *)
      || event(LeakedAK(pubAK)) (* Assumption that AK is secure is ALWAYS mandatory *)
      || event(LeakedKAK(pubKAK)) (* Req. for A only *)
      || event(LeakedTSK(pubTSK)) (* Can be leaked in isolation for A or B *)
      (* || event(EvidenceOracle(pubKAK, dev_state, pat)) *) 
;

  (* 
     Hypothesis: The EvidenceOracle event accounts for enclave identity compromise without policy checks
     Expected A: true under Option A when event(EvidenceOracle(pubKAK, dev_state, pat)) is present on RHS
     Expected B: false when InvalidPolicies is not accounted for
     Interpretation: Appraisal policies are always req. to resist threat of Evidence signing oracles 
  *) 
  ( event(ClientRANew(NULL_ID, NULL_pubkey, pubAK, pubKAK, pubTSK, pubRVP, dev_state, (pat,kat)))
    && event(ClientFinRecentAgr(ID,ID_C,pubTSK,psk,offer,mode,kc,ks,ems,rms,cr,sr))
    && event(ClientStateEvKc((pat,kat), kc))
  ) ==> event(ProvisionedTargetEnv(ID, pubAK, pubTSK, dev_state)) 
      || event(CompromisedCA(pubCA)) (* Req. for B only *)
      || event(CompromisedCSP(pubCSP)) (* Req. for A+B *)
      (* || event(InvalidPolicies(pubRVP)) *)
      || event(LeakedAK(pubAK)) (* Assumption that AK is secure is ALWAYS mandatory *)
      || event(LeakedKAK(pubKAK)) (* Req. for A only *)
      || event(LeakedTSK(pubTSK)) (* Can be leaked in isolation for A or B *)
      || event(EvidenceOracle(pubKAK, dev_state, pat))
.

(**********************************************************************)
(* Key Secrecy Correspondence [seat-use-cases-01 §4.2, §3.5.2] *)
(* Tag: Q-SECRECY *)
(**********************************************************************)

query dev_state,dev_state1,dev_state2:measurements,quote:bitstring,
      cr:random, sr:random, cr':random, sr':random,
      ID,ID_C:identity,pubTSK:pubkey,pubAK:pubkey, pat,kat: bitstring,
      psk:preSharedKey, e:bitstring, pubRVP,pubCA,pubCSP,pubKAK:pubkey,
      offer:params, mode:params,
      kc:ae_key,ks:ae_key,kch,ksh:ae_key,ems:bitstring,rms:bitstring;

  (*************************************************)
  (* Confirm that attacker *does* have access to 
     handshake secrets with same evidence in context *)
  (***************************************************)
  
  (* Reachability check (expect false): Server exposes HSK. Result: false. *)
    event(AttackerControlsHSK(kch,ksh)) ==> false;
  
  (* Reachability check (expect false): Client accepts HSK. Result: false. *)
    event(ClientStateEvKch((pat,kat),kch)) ==> false;
  
  (* Reachability check (expect false): Confirms that a trace exists 
     where the client and server agree on the same handshake key kch.
     Result: false. *)
    (
      event(AttackerControlsHSK(kch,ksh))
      && event(ClientStateEvKch((pat,kat),kch))
    ) ==> false
;

(*************************************************)
(* Property: Key Secrecy Correspondence 
   Goal: kc stays out of attacker(_) reach unless 
         a named compromise occurred.            *)
(*************************************************)

   (* Hypothesis: The attacker cannot compromise the application traffic keys as long as Remote Attestation is 
                  assumed sound and without compromise, even when the TLS signing key is compromised.

          Branch: A+B
        Expected: true
   *)
   attacker(kc) && 
   (
       event(ClientRANew(NULL_ID, NULL_pubkey, pubAK, pubKAK, pubTSK, pubRVP, dev_state, (pat, kat)))
    && event(ClientFinRecentAgr(ID, ID_C, pubTSK, psk, offer, mode, kc, ks, ems, rms, cr, sr))
    && event(ClientStateEvKc((pat, kat), kc))
  ) ==>          
         event(CompromisedCSP(pubCSP)) 
      || event(InvalidPolicies(pubRVP)) (* Always req. to resist EvidenceOracle compromise *)
      || event(LeakedAK(pubAK)) 
      || event(LeakedKAK(pubKAK))
      (* || event(LeakedTSK(pubTSK)) *) (* Allow the TLS signing key to be compromised *)
;

   (*  Hypothesis: The attacker cannot compromise the application traffic keys as long as the TLS signing
                   key is assumed secure alongside secure webPKI, even if Remote Attestation is compromised.
       
       Expected A: counterexample (false)
       Expected B: true
   Interpretation: webPKI provides additive security to app traffic secret compromise
   *)
   attacker(kc) && 
   (
       event(ClientRANew(NULL_ID, NULL_pubkey, pubAK, pubKAK, pubTSK, pubRVP, dev_state, (pat, kat)))
    && event(ClientFinRecentAgr(ID, ID_C, pubTSK, psk, offer, mode, kc, ks, ems, rms, cr, sr))
    && event(ClientStateEvKc((pat, kat), kc))
  ) ==>          
         event(CompromisedCA(pubCA)) 
      || event(InvalidPolicies(pubRVP)) (* Always req. to resist EvidenceOracle compromise *)
      || event(LeakedTSK(pubTSK)) 
;

   (*  Hypothesis: The attacker cannot compromise the application traffic keys under any circumstance.
           Branch: A+B
         Expected: counterexample (false)
   Interpretation: ProVerif can find a compromise event, indicating the results above for A and B are sound.
   *)
   attacker(kc) && 
   (
       event(ClientRANew(NULL_ID, NULL_pubkey, pubAK, pubKAK, pubTSK, pubRVP, dev_state, (pat, kat)))
    && event(ClientFinRecentAgr(ID, ID_C, pubTSK, psk, offer, mode, kc, ks, ems, rms, cr, sr))
    && event(ClientStateEvKc((pat, kat), kc))
  ) ==> false
.

(**********************************************************************)
(* Agreement of Composition TLS+RA in post-handshake app data [seat-use-cases-01 §4.4, §3.3.1] *)
(* Tag: Q-REPLAY *)
(**********************************************************************)

query ev,ev1,ev2,kem_ss,kem_ss1,kem_ss2:bitstring,kch,kch1,kch2,ks,kc,kc1,kc2:ae_key,
      cr,sr,cr',sr':random,ID,ID_C:identity,pubTSK,pubAK,pubKAK,pubCA,pubRVP,
      pubCSP:pubkey,psk:preSharedKey,ems,rms:bitstring, pat,kat: bitstring,
      dev_state:measurements,offer,mode:params,req_ctx,app_msg:bitstring,e:bitstring;

(* Goal: injective version of Target Environment Engagement, pushed
  past RA/TLS completion to the actual encrypted app-data exchange. *)

(*  Hypothesis: Injective agreement of application data with a genuine enclave is possible
                as long as Remote Attestation is assumed sound and without compromise, even 
                when the TLS signing key is compromised.

   Expected A: true
   Expected B: counterexample (false)
   *)
  inj-event(ClientReceivesAppData(ID,pubTSK,pubKAK,cr,sr,req_ctx,ems,ks,kc,dev_state,app_msg))
  ==> (
       inj-event(ServerSendsAppData(ID,pubTSK,pubKAK,cr,sr,req_ctx,ems,ks,kc,dev_state,app_msg))
       && event(ProvisionedTargetEnv(ID, pubAK, pubTSK, dev_state))
      )
      || event(CompromisedCSP(pubCSP)) 
      || event(InvalidPolicies(pubRVP)) 
      || event(LeakedAK(pubAK)) 
      || event(LeakedKAK(pubKAK)) 
      (* || event(LeakedTSK(pubTSK)) *) (* Allow the TLS signing key to be compromised *)
;

(* Hypothesis: Injective agreement of application data with a genuine enclave is possible
               when the TLS signing key is assumed secure alongside secure webPKI, even if 
               Remote Attestation may be compromised.
   
   Expected A: counterexample (false)
   Expected B: true
   Interpretation: webPKI provides additive security benefit alongside Remote Attestation
   *)
   inj-event(ClientReceivesAppData(ID,pubTSK,pubKAK,cr,sr,req_ctx,ems,ks,kc,dev_state,app_msg))
   ==> (
        inj-event(ServerSendsAppData(ID,pubTSK,pubKAK,cr,sr,req_ctx,ems,ks,kc,dev_state,app_msg))
        && event(ProvisionedTargetEnv(ID, pubAK, pubTSK, dev_state))
       )
       || event(CompromisedCA(pubCA)) 
       || event(InvalidPolicies(pubRVP)) (* Always req. to resist EvidenceOracle compromise *)
       || event(LeakedTSK(pubTSK)) 
;

(*  Hypothesis: When the Client recieves application data, it came from a legitimately provisioned
                 server--under any circumstance whatsoever.

      Expected: counterexample (false)
        Branch: A+B
Interpretation: ProVerif can find a compromise event, indicating the results above are sound.
*)
  inj-event(ClientReceivesAppData(ID,pubTSK,pubKAK,cr,sr,req_ctx,ems,ks,kc,dev_state,app_msg))
  ==> (
       inj-event(ServerSendsAppData(ID,pubTSK,pubKAK,cr,sr,req_ctx,ems,ks,kc,dev_state,app_msg))
       && event(ProvisionedTargetEnv(ID, pubAK, pubTSK, dev_state))
      )
  (* No RHS Disjuncts - Expected false *)
.
