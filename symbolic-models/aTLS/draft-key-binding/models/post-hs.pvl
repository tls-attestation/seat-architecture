(********************************************************)
(* Client_EA_CV_fin Process                             *)
(********************************************************)

(* Prune branches that aren't matched with post-handshake *)
restriction opt:attestation_option;
  event(AttestationTimingWindow(Intra)) ==> (* not *) false
.

let Client_EA( (* Runs after the Client handshake's Finished. *)
  ID_C: identity, ID_S: identity, TargetHost: identity, pubTSK: pubkey, server_cert: bitstring,
  pubVOK: pubkey, pubCSP: pubkey, pubCA: pubkey, idOption: branch_option,
  psk: preSharedKey, cr: random, sr: random, offer: params, mode: params, kem_ss: bitstring,
  kch: ae_key, ks: ae_key, kc: ae_key, ems: bitstring, rms: bitstring, shash_algo: hash_alg
) =
(
  new req_ctx: bitstring;  (* generate fresh certificate_request_context [Sec. 4, RFC9261] *)
  let req_msg = AuthenticatorRequest(req_ctx) in
  out(io, AuthFrame(ALTA_magic, auth_request, req_msg));  (* send Authenticator Request inside Shim Mode AuthFrame [Sec. 7, ALTEA] *)

  in(io, (ea_frame: bitstring)) [precise]; (* receive Authenticator message wrapped in AuthFrame [Sec. 7, ALTEA] *)
  let AuthFrame(=ALTA_magic, =authenticator, ea_bundle) = ea_frame in (* enforce ALTA magic value and authenticator msg type *)
  let AuthenticatorResponse(CRT(ea_cert), CV(ea_sg), FIN(ea_mac)) = ea_bundle in (* pattern-match components: Certificate, CertificateVerify, and Finished [Sec. 3.4, ALTEA] *)
  
  (* ea_cert carries attestation evidence + server_cert matching the handshake *)
  let (cmw:bitstring, =server_cert) = ea_cert in (* Pattern match CMW [RFC 9999], server_cert (may be self-signed) *)

  let (id_pub_pair:bitstring, sig1:bitstring) = server_cert in  (* check server_cert format *)
  let (cert_subject:identity,=pubTSK) = id_pub_pair in  (* universal parse of certificate; pubTSK is the TLS authentication key [seat-cc-workload-identity §2] *)

  let exported_val = ea_derive_attestation_binder(ems, req_ctx) in
  let sessionNonce = hash(StrongHash, (exported_val, pubTSK)) in (* legacy: was 'rdata' *)

  (* ==================================================================== *)
  (* Appraisal Policy Branching -- shared with intra via atls-library.pvl *)
  (* ==================================================================== *)

  VerifierAppraisal(
    idOption, ID_C, ID_S, TargetHost, pubCA, pubCSP, pubVOK, pubTSK, 
    server_cert, cmw, sessionNonce, cr, sr, shash_algo, psk, offer, mode, kem_ss, kch,
    
    (* Intra-specific params (Dummies) *)
    Nil, Nil, Nil, b2mk(Nil), b2mk(Nil),
    
    (* Post-specific params (Active) *)
    req_msg, ea_cert, ea_sg, ea_mac, ems, ks, kc, rms, req_ctx
  ) 
  (* The VerifierAppraisal process will call Intra_Client_CV_Fin upon completetion *)
).

(********************************************************)
(* Server Authenticator                                 *)
(********************************************************)

(* Runs after the vanilla handshake's Finished. Owns all evidence construction. *)

let Server_EA(server_cert: bitstring, ID_S: identity, privTSK: privkey, privKAK: privkey,
    dev_status: measurements, psk: preSharedKey, cr: random, sr: random, offer: params, mode: params,
    kem_ss: bitstring, kch: ae_key, ks: ae_key, kc: ae_key, ems: bitstring, rms: bitstring, hash_algo: hash_alg) =
(
  in(io, req_frame: bitstring) [precise];  (* receive Authenticator Request frame from Client [Sec. 7, ALTEA] *)
  let AuthFrame(=ALTA_magic, =auth_request, req_msg) = req_frame in (* enforce ALTA magic value and auth_request msg type *)
  let AuthenticatorRequest(req_ctx) = req_msg in  (* pattern-match to extract certificate_request_context *)

  let pubTSK = pk(privTSK) in
  let pubKAK = pk(privKAK) in

  (* Evidence generation *)
  let exported_val = ea_derive_attestation_binder(ems, req_ctx) in  (* derive exported key material using exporter_secret (ems) and req_ctx as context_value [Sec. 7.5, RFC9846; Sec. 5.1, draft-fossati-seat-expat] *)
  let eat_nonce = hash(StrongHash, (exported_val, pubTSK)) in (* legacy: was 'rdata' *)
  new ev_return: channel;
  ( EvidenceGeneration(dev_status, privKAK, pubTSK, eat_nonce, cr, sr, ev_return) )
  |
  ( 
  in(ev_return, (* Collect Conceptual Message Wrapper [RFC 9999] *)
    (cmw: bitstring));

  let ea_cert = (cmw,server_cert) in (* pack opaque cmw with cert message *)

  let ea_hs_ctx = ea_derive_hs_context(ems) in  (* derive Authenticator Handshake Context using label "EXPORTER-server authenticator handshake context" [Sec. 5.1, RFC9261] *)
  let log_EA_CRT = (ea_hs_ctx, req_msg, CRT(ea_cert)) in  (* construct Authenticator transcript log containing ea_hs_ctx || Authenticator Request || Certificate [Sec. 5.2.2, RFC9261] *)

  let ea_sg = sign(privTSK, hash(hash_algo, (ea_cv_context, log_EA_CRT))) in  (* sign Authenticator transcript hash using ephemeral private key privTSK [Sec. 5.2.2, RFC9261] *)
  let log_EA_CV = (log_EA_CRT, CV(ea_sg)) in  (* construct Authenticator transcript log containing log_EA_CRT || CertificateVerify *)

  let ea_fin = ea_derive_fin_key(ems) in  (* derive Authenticator Finished Key using label "EXPORTER-server authenticator finished key" [Sec. 5.1, RFC9261] *)
  let ea_mac = hmac(StrongHash, b2mk(ea_fin), log_EA_CV) in  (* compute Authenticator Finished HMAC over log_EA_CV using ea_fin key [Sec. 5.2.3, RFC9261] *)

  event PreServerComp(ID_S,psk,offer,mode,kc,ks,ems,cr,sr,pubTSK,dev_status);
  event ServerStateEvKc(cmw,kc);
  event ServerStateEvKch(cmw,kch);
  event ServerStateEv(cmw,kem_ss);

  let ea_bundle = AuthenticatorResponse(CRT(ea_cert), CV(ea_sg), FIN(ea_mac)) in
  out(io, AuthFrame(ALTA_magic, authenticator, ea_bundle));  (* send Authenticator message bundle inside Shim Mode AuthFrame [Sec. 7, ALTEA] *)

  new app_msg: bitstring;  (* generate fresh application payload *)
  event ServerSendsAppData(ID_S,pubTSK,pubKAK,cr,sr,req_ctx,ems,ks,kc,dev_status,app_msg);
  out(io, ph_msg(app_msg, ae2b(ks)))  (* encrypt and transmit post-handshake record with server application write key ks *)
)).

(********************************************************)
(* Client *)
(********************************************************)
(* (for usability/extensibility), we can use variables for messages, 
e.g., SH so that these variables can then be used in logs *)

let Client(
  ID_C:identity,ID_S:identity,pubVOK:pubkey,pubCSP:pubkey,pubCA:pubkey,
  idOption:branch_option
) =
(
  in(io, (TargetHost: identity, ioffer:params));  (* io is a public channel. ioffer is obtained from adversary as input to allow adversary to generate all valid patterns *)
  let nego(=aTLS,MLKEM_13_C(ka,eee),hash_algo,ev_type) = ioffer in
  (* Message parsing modeled as a pattern-match with the constructors [Bhargavan2017; p. 17] *)

  let (dk:kem_priv, ek:kem_pub) = kem_keygen() in
  (* (dk,ek) returned by kem_keygen; see def. above in the same file *)
  let offer = nego(aTLS,MLKEM_13_C(ka,ek),hash_algo,ev_type) in
  (* Note that we really need MLKEM_13_C(ka,ek) *)

  new cr:random;  (* random nonce: ClientHello.random; 8446bis page 10 *)
  let ch = CH(cr,offer,TargetHost) in
  let psk = NoPSK in (* non-PSK handshake, so use NoPSK to get zero. *)
  let (es:bitstring,kb:mac_key,kc0:ae_key,ems0:bitstring) = kdf_es(psk,msg2bytes(ch)) in  (* non-PSK handshake, so use NoPSK to get zero. log1 is simply ch *)
  (* If a given secret is not available, then the 0-value consisting of a string of Hash.length bytes set to zeros is used.
  Note that this does not mean skipping rounds, so if PSK is not in use, Early Secret will still be HKDF-Extract(0, 0). [Section 7.1, RFC9846]  *)
  event ClientOffersHash(cr,hash_algo); (*hash algorithm used for HKDF [Table 4 in Appendix B.4 8446bis]*)
  event ClientOffersKEX(cr,MLKEM_13_C(ka,ek));  (* key_share extension: client's ML-KEM encapsulation key for the offered parameter set [sec. 4.1.1. in 8446; RFC 9846 sect. 4.3.8] *)
  event ClientOffersEvType(cr,ev_type);
  out(io, ch);  (* send ClientHello message *)

  in(io, SH(sr,mode)) [precise];  (* Receive ServerHello *)
  let nego(=aTLS,MLKEM_13_S(=ka,ciph),shash_algo,sev_type) = mode in  (* pattern matching to ensure that received mode is in the desired format and negotiates the same KEM parameter set ka as sent *)
  event ClientAcceptsKEM(cr, ka);  (* Capture KEM downgrade / WeakKEM *)
  event ClientAcceptsHash(cr, shash_algo); (* Capture TLS 1.2 downgrade attack *)
  let log_SH = (ch,SH(sr,mode)) in  (* after this step, log_SH contains sent ClientHello || received ServerHello *)

  let kem_ss = kem_decap(ka, dk, ciph) in  (* ML-KEM shared secret in Key Derivation [Sec. 7.1, RFC9846] *)
  let (hs:bitstring,kch:ae_key,ksh:ae_key,kcm:mac_key,ksm:mac_key) = kdf_hs(es,kem_ss,log_SH) in
  in(io,CRT(server_cert));  (* receive Certificate message; server_cert only, no evidence carried here *)
  let (id_pub_pair:bitstring, sig1:bitstring) = server_cert in  (* unpack cert format only — no trust check performed here *)
  let (cert_subject:identity,pubTSK:pubkey) = id_pub_pair in  (* pubTSK is needed to verify CertificateVerify below; its trustworthiness is judged later, in Client_EA *)

  let log_CRT = (log_SH,CRT(server_cert)) in  (* after this step, log_CRT contains sent ClientHello || received ServerHello || received Certificate *)

  in(io,CV(sg));  (* receive CertificateVerify message *)
  if verify(pubTSK,hash(shash_algo,log_CRT),sg) = true then  (* log_CRT contains msgs up to Certificate *)
  let log_CV = (log_CRT,CV(sg)) in  (* after this step, log_CV contains sent ClientHello || received ServerHello || received Certificate || received CertificateVerify *)

  in(io,FIN(m1));  (* receive server Finished message containing hmac of log *)
  if m1 = hmac(StrongHash,ksm,log_CV) then    (* hmac(hash_alg,mac_key,bitstring); mac_key = ksm using Client's perspective of log_CV; that's why client needs to generate server keys also *)
  (
    let log_SFIN = (log_CV,FIN(m1)) in  (* after this step, log_SFIN contains sent ClientHello || received ServerHello || received Certificate || received CertificateVerify || received server Finished *)
    let (ms:bitstring,kc:ae_key,ks:ae_key,ems:bitstring) = kdf_ms(hs,log_SFIN) in
    let m2 = hmac(StrongHash,kcm,log_SFIN) in  (* hmac(hash_alg,mac_key,bitstring); mac_key = kcm *)
    let log_CFIN = (log_SFIN,FIN(m2)) in  (* after this step, log_CFIN contains sent ClientHello || received ServerHello || received Certificate || received CertificateVerify || received server Finished || sent client Finished *)
    let rms =  kdf_psk(ms,log_CFIN) in

    event ClientFin1WayAgr(ID_S,pubTSK,psk,offer,mode,kc,ks,ems,rms);
    event ClientFinRecentAgr(ID_S,ID_C,pubTSK,psk,offer,mode,kc,ks,ems,rms,cr,sr);
    event ClientFinished(pubTSK,psk,cr,sr,offer,mode,kc,ks,ems,rms);
    out(io,FIN(m2));  (* send ClientFinished message *)

    (* continue from vanilla TLS handshake into the Exported Authenticator handshake, where
       identity/workload appraisal (idOption branching) and evidence appraisal now live *)
    Client_EA(ID_C,ID_S,TargetHost,pubTSK,server_cert,pubVOK,pubCSP,pubCA,idOption,psk,cr,sr,offer,mode,kem_ss,kch,ks,kc,ems,rms,shash_algo)
  )
).

(********************************************************)
(* Server *)
(********************************************************)

let Server(ID_S:identity, dev_status1: measurements, privKAK: privkey, privTSK: privkey, server_cert:bitstring) =
(
  in(io, ch:msg); (* Receive ClientHello message from Client and store in variable ch *)
  let CH(cr,offer,sni) = ch in (* pattern matching to ensure that received message in variable ch is in the desired format fun CH(random,params,random):msg [data]. nonce will be stored in variable cr and parameters will be stored in variable offer. Attestation nonce will be stored in ar *)
  let nego(=aTLS,MLKEM_13_C(ka,ek),xhash_algo,xev_type) = offer in (* pattern matching to ensure that received message in variable offer is in the desired format fun nego(tls_typ,kex_alg,hash_alg,ev_typ): params [data]. *)
  let psk = NoPSK in (* non-PSK handshake, so use NoPSK to get zero. *)
  let (es:bitstring,kb:mac_key,kc0:ae_key,ems0:bitstring) = kdf_es(psk,msg2bytes(ch)) in  (* non-PSK handshake, so use NoPSK to get zero. log1 is simply ch *)

  new sr:random; (* Server nonce used in "SH" below *)
  (* instead of SH as input in original *)
  in(io, smode:params);  (* io is a public channel. It is obtained from adversary as input to allow adversary to generate all valid modes *)
  let nego(=aTLS,MLKEM_13_S(=ka,eee),hash_algo,ev_type) = smode in (* check format of smode and ensure that the KEM parameter set matches ka as in ClientHello message *)

  new ss_kem: bitstring;  (* freshly generated ML-KEM shared secret *)
  let ciph = kem_encap(ka, ek, ss_kem) in
  (* ciph binds ss_kem to the client's ek under parameter set ka; see def. above in the same file *)
  let mode = nego(aTLS,MLKEM_13_S(ka,ciph),hash_algo,ev_type) in  (* Server selects a mode that fixes the KEM parameter set and all other session parameters [Bhargavan2017; p.16] *)
  out(io,SH(sr,mode));  (* Send ServerHello containing server nonce and selected mode *)
  let log_SH = (ch,SH(sr,mode)) in  (* received ClientHello || sent ServerHello *)
  event ServerChoosesKEX(cr,sr,MLKEM_13_S(ka,ciph));  (* ML-KEM parameter set *)
  event ServerChoosesHash(cr,sr,hash_algo);  (* hash algorithm used for HKDF/transcript hash [Table 4 in Appendix B.4 8446bis] *)
  event ServerChoosesATLS(cr,sr,aTLS); (* Standard or Attested TLS *)
  event ServerChoosesEvType(cr,sr,ev_type);  (* Evidence type *)

  let kem_ss = ss_kem in  (* ML-KEM shared secret bound into ciph via kem_encap above; Key Derivation [Sec. 7.1, RFC9846] *)
  let (hs:bitstring,kch:ae_key,ksh:ae_key,kcm:mac_key,ksm:mac_key) = kdf_hs(es,kem_ss,log_SH) in
  
  (* https://github.com/Inria-Prosecco/reftls/blob/a71a74538e8af80dec5f6719f9e726b8c654468a/pv/tls-lib-rfc8446.pvl#L598 *)
  out(io,(kch,ksh)); (* explictly expose derived handshake keys, same as upstream reftls model *)
  event AttackerControlsHSK(kch,ksh);

  let pubTSK = pk(privTSK) in
  event ServerID(ID_S,kem_ss);

  out(io,CRT(server_cert));  (* Send Certificate message; server_cert only, no evidence carried here *)
  let log_CRT = (log_SH,CRT(server_cert)) in  (* received ClientHello || sent ServerHello || sent Certificate *)

  (* CertificateVerify message *)
  let sg     = sign(privTSK ,hash(hash_algo,log_CRT)) in  (* A signature over the value Transcript-Hash(Handshake Context, Certificate) [Sec. 4.5, RFC9846] using TSK; Handshake Context via first row of table in Sec. 4.5 of RFC9846. log_CRT contains Handshake Context, Certificate. *)
  out(io,CV(sg));  (* Send CertificateVerify message *)
  let log_CV = (log_CRT,CV(sg)) in  (* received ClientHello || sent ServerHello || sent Certificate || sent CertificateVerify *)

  (* serverFinished message *)
  let m1 = hmac(StrongHash,ksm,log_CV) in  (* A MAC over the value Transcript-Hash(Handshake Context, Certificate, CertificateVerify) using a MAC key derived from the Base Key [Sec. 4.5, RFC9846]. Handshake Context via first row of table in Sec. 4.5 of RFC9846. log_CV contains Handshake Context, Certificate, CertificateVerify  *)
  let log_SFIN = (log_CV,FIN(m1)) in  (* received ClientHello || sent ServerHello || sent Certificate || sent CertificateVerify || sent ServerFinished *)
  let (ms:bitstring,kc:ae_key,ks:ae_key,ems:bitstring) = kdf_ms(hs,log_SFIN) in  (* Key Derivation [Sec. 7.1, RFC9846] *)
  out(io,FIN(m1));  (* Send serverFinished message *)

  (* clientFinished message *)
  in(io,FIN(m2));  (* Receive client Finished message *)
  if m2 = hmac(StrongHash,kcm,log_SFIN) then  (* kcm represents kcm; check mac of finished from client *)
    let log_CFIN = (log_SFIN,FIN(m2)) in  (* received ClientHello || sent ServerHello || sent Certificate || sent CertificateVerify || sent ServerFinished || received ClientFinished *)
    let rms =  kdf_psk(ms,log_CFIN) in
  event ServerFinished(cr,sr,psk,pubTSK,offer,mode,kc,ks,ems,rms);

  (* continue from vanilla TLS handshake into the Exported Authenticator handshake, where
     evidence construction (quote, AK signature over dev_status1) now happens *)
  Server_EA(server_cert,ID_S,privTSK,privKAK,dev_status1,psk,cr,sr,offer,mode,kem_ss,kch,ks,kc,ems,rms,hash_algo)
).
