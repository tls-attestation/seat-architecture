(**********************************************************************)
(* Generate Evidence *)
(**********************************************************************)

let EvidenceGeneration(dev_status: measurements, privKAK: privkey, pubTSK: pubkey, eat_nonce: bitstring,
  cr: random, sr: random, return_chan: channel
) =
(
  let pubKAK = pk(privKAK) in

  (* Key Attestation Token *)  (*  cnf   , key-attributes      , measurements,nonce *)
  let pat_claims = eat_pat_profile(pubKAK, TrustedNonExportable, dev_status, eat_nonce) in
  
  let cdata = (StrongHash, pat_claims) in
  out(io, (dev_status, cdata)); (* Submit cdata to Attestation Environment, dev_status is for context *)

  (* Receive signed data back from Attestion Environment (could be a signing oracle) *)
  in(io, (dataSign: bitstring)) [precise];
  let (signed_claims: bitstring, pat_sig: bitstring) = dataSign in

  let eat_pat_profile(=pubKAK, evidenceAttr: attribute, =dev_status, =eat_nonce) = signed_claims in
  let pat = (signed_claims, pat_sig) in

  (* Key Attestation Token *)  (*  cnf   , key-attributes, nonce *)
  let kat_claims = eat_kat_profile(pubTSK, evidenceAttr  , eat_nonce) in
  let kat = (kat_claims, sign(privKAK, kat_claims)) in

  event ServerAssertsProvenance(cr, sr, evidenceAttr);

  (* Conceptual Message Wrapper, CMW [RFC 9999] *)
  let cmw = (pat, kat) in (* Place Combined Attestation Bundle (CAB) into CMW *)
  out(return_chan, cmw) 
).


(**********************************************************************)
(* Attestation Environment and Oracle Process *)
(**********************************************************************)

event EvidenceOracle(pubkey, measurements, bitstring).

let Attestation_Environment =
(
  (* model of caller_device (measurements): input from adversary *)
  (* Lets the adversary instantiate any desired VM *)
  in(io, (caller_device:measurements, cdata: bitstring));

  (* Deconstruct hashed cdata (claims data/rdata) to let adversary pick and choose values *)
  let (=StrongHash, pat_claims:bitstring) = cdata in (* This is an abstraction convenience, cdata is otherwise an opaque one-way hash *)
  let eat_pat_profile(reqKAK:pubkey, evidenceAttr:attribute, =caller_device, eat_nonce:bitstring) = pat_claims in

  get agent_keys(_,trusted_device,_,_,_,_,privKAK,pubKAK) in
  (* The KAK pair are confidential (never leave the enclave) unless compromised (see LeakedKAK) *)

  (* Determine the expected values for confidential claims *)
  let genuine_claims = eat_pat_profile(pubKAK, TrustedNonExportable, trusted_device, eat_nonce) in

  (* Branch AE signing invocation based on API configuration of the original caller *)

  (*==============================*)
  (* Genuine AE with trusted APIs *)
  (*==============================*)
  if cdata = (StrongHash, genuine_claims) then ( (* invoke the genuine AE for trusted attestation requests *)
    get agent_keys(_,=trusted_device,_,_,privAK,pubAK,_,_) in
    let hwQuote = (trusted_device, cdata) in
    let pat = (pat_claims, sign(privAK, hwQuote)) in 
    out(io, pat)

  (*================================*)
  (* AE oracle with untrusted APIs  *)
  (*================================*)
  ) else if evidenceAttr = ExternalOrUntrusted then (  
    (* Some workloads might accept external API calls, representing an oracle *)
    get agent_keys(_,_,_,_,privAK,pubAK,_,_) in (* Adversary still has unconstrained access to any endorsed AK *)
    let hwQuote = (caller_device, cdata) in
    let pat = (pat_claims, sign(privAK, hwQuote)) in 
    event EvidenceOracle(reqKAK, caller_device, pat);
    out(io, pat)
  )
).
