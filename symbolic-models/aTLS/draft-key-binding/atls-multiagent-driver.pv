(* Run as follows with subfolder <traces>:
See commands.txt for run commands across variants.
proverif205 -lib tls-lib-simple.pvl -html traces tls13-multiagent.pv 2>&1 | tee log.txt
*)

(* 
Summary: 
  Server's identity: ID_S (* pubTSK OR SubjectAltName of X.509 e.g., FQDN *)
  Key associated with VM identity: pubTSK
  General organization for modeling: (measurements,pubTSK,pubAK)

Details:
  Each cVM is identified by ID_S.
  The model allows multiple tenants (guest VM) per server machine. 
  So multiple pubTSK per server machine. 

We want to model that some server machines may be compromised while others remain secure.
The compromise of a server machine is modelled by leaking privAK or privTSK.
*)

(* Generation events *)
event CSRSigned(identity,pubkey).
event ProvisionedTargetEnv(identity, pubkey, pubkey, measurements).
event EndorsementsIssued(identity,pubkey).
event IdentityManifestIssued(identity, measurements).

(* WebPKI Certificates *)
let gen_certs_csr (privCA:privkey,ID_S:identity,pubTSK:pubkey) = 
  let CA_sig = sign(privCA,(ID_S,pubTSK)) in   
  let server_cert = ((ID_S,pubTSK),CA_sig) in  (* PKI cert = {ID_S,pubTSK_S}CA [seat-cc-workload-identity §6] *)
  event CSRSigned(ID_S,pubTSK);
  out(io, server_cert)
.

(* Generate the actual cVMs *)
let gen_agents_data (privCA:privkey, idOption: branch_option) = 
  (* Generate the hardware-backed attestation key (AK) that will sign the evidence *)
  new privAK: privkey;  
  let pubAK = pk(privAK) in
  out(io,pubAK); 

  (* Universal Entity ID per machine, assumed nulled out by CSP later *)
  new UEID: identity;  
  out(io, UEID);

  if idOption = OptionA then (
    (* OPTION A: Attestation-Anchored Key [seat-cc-workload-identity §5] *)
    (* The workload is identified solely by its measurements and the attested key *)
    !( 
      (* Launch measurements of the Target Environment *)
      new dev_statusRef: measurements;  
      out(io, dev_statusRef);

      (* Per cVM Key Attestation Key *)
      new privKAK: privkey;
      let pubKAK = pk(privKAK) in
      out(io,pubKAK);

      !( (* A single identity can validly issue multiple ephemeral TLS signing keys (TSK) *)
        new privTSK: privkey;  
        let pubTSK = pk(privTSK) in

        let ID_S = dev2id(dev_statusRef) in 
        out(io,(ID_S,pubTSK));  

        (* Provision the target environment and generate the PKI certificate tying ID_S to pubTSK *)
        event ProvisionedTargetEnv(ID_S, pubAK, pubTSK, dev_statusRef);
        insert agent_keys(UEID,dev_statusRef,privTSK,pubTSK,privAK,pubAK,privKAK,pubKAK)
      )   
    )
  ) 
    else if idOption = OptionB then (
    (* OPTION B: PKI-Anchored Certificate with Workload Identity [seat-cc-workload-identity §6] *)
    (* The identity (ID_S) is a distinct identifier, bound later via a CA-signed cert *)
    !(
      new ID_S:identity;  
      out(io,ID_S);  

      (* Launch measurements of the Target Environment *)
      new dev_statusRef: measurements;  
      out(io, dev_statusRef);

      (* Per cVM Key Attestation Key *)
      new privKAK: privkey;
      let pubKAK = pk(privKAK) in
      out(io,pubKAK);

      !( (* A single identity can validly issue multiple ephemeral TLS signing keys (TSK) *)
        new privTSK: privkey;  
        let pubTSK = pk(privTSK) in
        out(io,pubTSK);  

        (* Provision the target environment and generate the PKI certificate tying ID_S to pubTSK *)
        event ProvisionedTargetEnv(ID_S, pubAK, pubTSK, dev_statusRef);
        insert agent_keys(UEID,dev_statusRef,privTSK,pubTSK,privAK,pubAK,privKAK,pubKAK);

        (* Issue webPKI cert for newwly generated TSK *)
        (gen_certs_csr(privCA,ID_S,pubTSK))
      )
    )
  )
.

let gen_endorsements (privCSP:privkey) =
  (* ISV optionally reports the hardware ID (UEID) and 
     the associated trusted pubAK keys *)
  get agent_keys(UEID,_,_,_,privAK,pubAK,_,_) in

  let UEID = NULL_ID in (* Assume CSP nulls out TEE hardware IDs [seat-cc-workload-identity §4] *)

  let CSP_sig = sign(privCSP,(UEID,pubAK)) in 
  let endorsements = ((UEID,pubAK),CSP_sig) in
  event EndorsementsIssued(UEID,pubAK);
  out(io, endorsements)
.

let gen_identity_document (pubCA: pubkey, privISV: privkey, idOption: branch_option) =
  get agent_keys(_,dev_statusRef,privTSK,pubTSK,_,pubAK,_,_) in 

  let workloadAttr = LocalNonExportable in

  if idOption = OptionA then (
    (* Option A: The measurement *is* the identity [seat-cc-workload-identity §5]. *)

    let ID_S = dev2id(dev_statusRef) in
  
    let manifest_tuple = (ID_S, workloadAttr) in
    let manifest_sig = sign(privISV, manifest_tuple) in 
    let manifest = (manifest_tuple, manifest_sig) in
    event IdentityManifestIssued(ID_S, dev_statusRef);
    out(io, manifest)

  ) 
  else if idOption = OptionB then (
    (* Option B: Manifest binds to a PKI identity, requires CA validation [seat-cc-workload-identity §6] *)

    in(io, (server_cert:bitstring)); 
    let (id_pub_pair:bitstring, sig1:bitstring) = server_cert in  
    let (ID_S:identity,=pubTSK) = id_pub_pair in 
    if verify(pubCA,id_pub_pair,sig1) = true then

    let manifest_tuple = (ID_S, workloadAttr, dev_statusRef) in
    let manifest_sig = sign(privISV, manifest_tuple) in 
    let manifest = (manifest_tuple, manifest_sig) in
    event IdentityManifestIssued(ID_S, dev_statusRef);
    out(io, manifest)
  )
.

let run_Client(pubCA, pubCSP, pubISV: pubkey, idOption: branch_option) = 
  (* Intuitively, the following models a single client (single agent) 
  and the replication takes care of multiple clients (multi agent) *)
  new ID_C: identity;

  (* Choose a server machine (potentially a compromised one) to communicate with. *)
  if idOption = OptionA then (
    !(
      (* Expecting a specific enclave workload type *)
      in(io, (TargetWorkload: measurements)); (* adversary controls lookup [seat-cc-workload-identity §5] *)
      let ID_S = dev2id(TargetWorkload) in

      (* The following replication models multiple sessions of client with these parameters *)
      !Client(ID_C, ID_S, pubISV, pubCSP, pubCA, idOption)
    )

  ) else if idOption = OptionB then (
    !(
      (* adversary controls lookup, i,e., untrusted DNS [seat-cc-workload-identity §6] *)
      in(io, (TargetHost: identity));
      let ID_S = TargetHost in

      (* The following replication models multiple sessions of client with these parameters *)
      !Client(ID_C, ID_S, pubISV, pubCSP, pubCA, idOption)
    )
  )
.

let run_Server(idOption:branch_option) = 
(* Intuitively, this models a single server and the replication takes care of multiple servers *)

  if idOption = OptionA then ( (* In Option A, the identity is intrinsically bound to the TLS signing key *)

    get agent_keys(_,workloadRef,privTSK,pubTSK,_,_,_,_) in (* Select a provisioned workload by it's launch measurements *)
    get agent_keys(_,_,=privTSK,_,_,_,privKAK,pubKAK) in  (* privTSK is confidential and should be matched with the same device's KAK *)
    
    (* Option A: The identity IS the measurement [seat-cc-workload-identity §5, self-signed cert with no validated PKI identity] *)
    let ID_S = dev2id(workloadRef) in
    let selfsign = ((ID_S, pubTSK), NULL_bs) in

    (* Server only holds privKAK/privTSK now [key-binding §8.3] *)
    !Server(ID_S, workloadRef, privKAK, privTSK, selfsign)

  ) else if idOption = OptionB then ( (* In Option B, identity is defined from the X.509 certificate *)
    
    (* Let adversary choose server certificate and initial cVM launch measurements *)
    in(io, (server_cert:bitstring,workloadRef:measurements)); 

    let (id_pub_pair:bitstring, sig1:bitstring) = server_cert in  
    let (SAN:identity,pubTSK:pubkey) = id_pub_pair in (* Configure SubjectAltName/SAN from cert *)
    (* Servers can be misconfigured, don't bother checking for CA signature here [seat-cc-workload-identity §6, §8 "Siloed appraisal"] *)

    (* Allow combinations, but for each private key, 
       choose the corresponding public key *)
    get agent_keys(UEID,_,privTSK,_,_,_,_,_) in (* Pair a private key to whatever the adversary picked *)
    get agent_keys(=UEID,_,_,_,_,_,privKAK,pubKAK) in (* privTSK is confidential and should be matched with the same device's KAK *)

    (* Server only holds privKAK/privTSK now [key-binding §8.3] *)
    !Server(SAN, workloadRef, privKAK, privTSK, server_cert)
  )
.

(* ============================================================ *)
(* Signing Key Compromise Events *)
(* ============================================================ *)

(* Mark the event when the keys of a specific machine are leaked
i.e., not all server machines are compromised at the same time *)
let LAK =
  get agent_keys(_,_,_,_,privAK,pubAK,_,_) in
  event LeakedAK(pubAK);  (* mark the leakage of AK [seat-cc-workload-identity §8, "Attestation Key compromise"] *)  
  out(io, privAK)
.

let LTSK =
  get agent_keys(_,_,privTSK,pubTSK,_,_,_,_) in 
  event LeakedTSK(pubTSK);  (* mark the leakage of TSK *)
  out(io, privTSK)
.

let LKAK =
  get agent_keys(_,_,_,_,_,_,privKAK,pubKAK) in
  event LeakedKAK(pubKAK);  (* mark the leakage of KAK [key-binding §8.3] *)
  out(io, privKAK)
.

let LCA(privCA:privkey) =
  event CompromisedCA(pk(privCA));  (* mark the compromise of the CA [seat-cc-workload-identity §6, PKI trust anchor] *)  
  out(io, privCA)
.

let LCSP(privCSP:privkey) =
  event CompromisedCSP(pk(privCSP));  (* mark the compromise of the CSP [seat-cc-workload-identity §3, CSP/Endorser] *)  
  out(io, privCSP)
.

let LISV(privISV:privkey) =
  event UncheckedPolicies(pk(privISV));  (* Simulates a failure to validate our own sigs  *)
  out(io, privISV)
.

(* set traceDisplay = long. Display full trace *)
(* set verboseClauses = short. *)
(* main system *)
(* process 0 *)
process
  (* Web PKI CA *)
  new privCA:privkey; 
  let pubCA = pk(privCA) in 
  out(io,pubCA);

  (* CSP / Independant Software Vendor *)
  new privCSP: privkey; 
  let pubCSP = pk(privCSP) in
  out(io, pubCSP);

  (* ISV / Policy issuer *)
  new privISV: privkey; 
  let pubISV = pk(privISV) in
  out(io, pubISV);

  in(io, idOption:branch_option) [precise];

    !(gen_agents_data(privCA,idOption)) 
  | !(gen_endorsements(privCSP)) 
  | !(gen_identity_document(pubCA,privISV,idOption))

  | !(run_Client(pubCA,pubCSP,pubISV,idOption)) 
  | !(run_Server(idOption))
  
  | !(Attestation_Environment)
  | !(LTSK)
  | !(LAK)
  | !(LKAK)
  | !(LCSP(privCSP)) (* We don't necessarily trust the CSP *)
  | !(LCA(privCA)) (* We don't necessarily trust the CA *)
  | !(LISV(privISV)) (* What happens if we don't validate our own policies? *)
  
(* END *)
