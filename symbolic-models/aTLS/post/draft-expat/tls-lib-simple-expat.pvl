(********************************************************)
event test4.

event Sent(bitstring).
event SentWithPubEK(bitstring,pubkey).
event Accepted(bitstring).
event AcceptedWithPubEK(bitstring,pubkey).
event SentRdata(bitstring).
event AcceptedRdata(bitstring).
event Conveyed(bitstring).
event Appraised(bitstring).
event ClientConn(bitstring).

event ClientOffersHash(random,hash_alg).
event ClientOffersKEX(random,kex_alg).
event ClientOffersEvType(random,ev_typ).

event ClientAcceptsElement(random, element).
event ClientAcceptsHash(random,hash_alg).

(* Old: ClientFinished(cr,sr,psk,pubLTK,offer,mode,kc,ks,ems,rms) *)
(* New: ClientFinishedeWithID(ID,pubLTK,pubAK,psk,cr,sr,offer,mode,kc,ks,ems,rms) *)
event ClientFinished(pubkey,
  preSharedKey,
  random,random,
  params,params,
  ae_key,ae_key,bitstring,bitstring).
event ClientFinishedAliveness(identity). (* ID_S *)
(* ClientFin1WayAgr(ID_S,pubLTK,psk,offer,mode,kc,ks,ems,rms) *)
event ClientFin1WayAgr(identity,
      pubkey,preSharedKey,
      params,params,
      ae_key,ae_key,bitstring,bitstring).
(* ClientFinRecent1WayAgr(ID_S,pubLTK,psk,offer,mode,kc,ks,ems,rms,cr,sr) *)
event ClientFinRecent1WayAgr(identity,
      pubkey,preSharedKey,
      params,params,
      ae_key,ae_key,bitstring,bitstring,
      random,random).
event ClientFinishedWeakAgr(identity,identity).  (* ID_S,ID_C *)
(* ClientFinAgr(ID_S,ID_C,pubLTK,psk,offer,mode,kc,ks,ems,rms) *)
event ClientFinAgr(identity,identity,
      pubkey,preSharedKey,
      params,params,
      ae_key,ae_key,bitstring,bitstring).
(* ClientFinRecentAgr(ID_S,ID_C,pubLTK,psk,offer,mode,kc,ks,ems,rms,cr,sr) *)
event ClientFinRecentAgr(identity,identity,
      pubkey,preSharedKey,
      params,params,
      ae_key,ae_key,bitstring,bitstring,
      random,random).
event ClientFinishedWithID(identity,pubkey,pubkey,
  preSharedKey,
  random,random,
  params,params,
  ae_key,ae_key,bitstring,bitstring).
(* New: ClientFinishedWithBothPub(pubAK,psk,pubEK,cr,sr,offer,mode,kc,ks,ems,rms) *)  
event ClientFinishedWithBothPub(pubkey,preSharedKey,
  pubkey,
  random,random,
  params,params,
  ae_key,ae_key,bitstring,bitstring).

(* ClientComp represents a composition event with parameters from both RA and TLS *)
(* ClientComp(ID_S,pubLTK,psk,offer,mode,kc,ks,ems,rms,cr,sr,pubEK,dev_state) *)
event ClientComp(identity,
      pubkey,preSharedKey,
      params,params,
      ae_key,ae_key,bitstring,bitstring,
      random,random,
      pubkey,bitstring).
(* ClientRA is for explicit agreement of all RA parameters: (pubAK,pubEK,dev_state,ev) *)
event ClientRA(pubkey,pubkey,bitstring,bitstring).
event ClientRA2(pubkey,pubkey,bitstring).
event ClientRA3(pubkey,pubkey,bitstring,identity).
event ClientRANew(identity,pubkey,pubkey,pubkey,bitstring,bitstring). (* ID,pubLTK,pubAK,pubEK,dev_state,ev *)
event ClientRAWithoutAK(pubkey,bitstring,bitstring).

event ClientStateEv(bitstring,bitstring).  (* quote,gxy *)
event ClientStateEvKch(bitstring,ae_key).  (* quote,kch *)
event ClientStateEvKc(bitstring,ae_key).  (* quote,kc *)

event ServerChoosesHash(random,random,hash_alg).
event ServerChoosesKEX(random,random,kex_alg).
event ServerChoosesEvType(random,random,ev_typ).
event ServerChoosesATLS(random,random,tls_typ).
(* Old: PreServerFinished(cr,sr,psk,pubLTK,offer,mode,kc,ks,ems) *)
(* New: PreServerFinishedWithID(ID,pubLTK,pubAK,psk,cr,sr,offer,mode,kc,ks,ems) *)
event PreServerFinished(pubkey,
			preSharedKey,
      random,random,
			params,params,
			ae_key,ae_key,bitstring).
event PreServerFinishedAliveness(identity). (* ID_S *)
(* PreServerFin1WayAgr(ID_S,pubLTK,psk,offer,mode,kc,ks,ems) *)
event PreServerFin1WayAgr(identity,
      pubkey,preSharedKey,
      params,params,
      ae_key,ae_key,bitstring).
(* PreServerFinRecent1WayAgr(ID_S,pubLTK,psk,offer,mode,kc,ks,ems,cr,sr) *)
event PreServerFinRecent1WayAgr(identity,
      pubkey,preSharedKey,
      params,params,
      ae_key,ae_key,bitstring,
      random,random).
event PreServerFinishedWeakAgr(identity,identity). (* ID_S,ID_C *)
(* PreServerFinAgr(ID_S,ID_C,pubLTK,psk,offer,mode,kc,ks,ems). *)
event PreServerFinAgr(identity,identity,
      pubkey,preSharedKey,
      params,params,
      ae_key,ae_key,bitstring). 
(* PreServerFinRecentAgr(ID_S,ID_C,pubLTK,psk,offer,mode,kc,ks,ems,cr,sr) *)
event PreServerFinRecentAgr(identity,identity,
      pubkey,preSharedKey,
      params,params,
      ae_key,ae_key,bitstring,
      random,random).
event PreServerFinishedWithID(identity,pubkey,pubkey,
			preSharedKey,
      random,random,
			params,params,
			ae_key,ae_key,bitstring).
(* New: PreServerFinishedWithBothPub(pubAK,psk,pubEK,cr,sr,offer,mode,kc,ks,ems) *)
event PreServerFinishedWithBothPub(pubkey,preSharedKey,
      pubkey,
      random,random,
			params,params,
			ae_key,ae_key,bitstring).
(* PreServerComp represents a composition event with parameters from both RA and TLS *)
(* PreServerComp(ID_S,pubLTK,psk,offer,mode,kc,ks,ems,cr,sr,pubEK,dev_state) *)
event PreServerComp(identity,
      pubkey,preSharedKey,
      params,params,
      ae_key,ae_key,bitstring,
      random,random,
      pubkey,bitstring).
(* ServerComp(ID_S,pubLTK,psk,offer,mode,kc,ks,ems,cr,sr,pubEK,dev_state) *)
event ServerComp(identity,
      pubkey,preSharedKey,
      params,params,
      ae_key,ae_key,bitstring,
      random,random,
      pubkey,bitstring).
(* ServerRA is for explicit agreement of all RA parameters: (ID,pubLTK,pubAK,pubEK,dev_state,ev) *)
event ServerRA(identity,pubkey,pubkey,pubkey,bitstring,bitstring).
event ServerRA2(pubkey,pubkey,bitstring).
event ServerRAWithoutAK(pubkey,bitstring,bitstring).
event ServerFinished(random,random,
                     preSharedKey, pubkey,
		     params,params,
		     ae_key,ae_key,bitstring,bitstring).

event ServerStateEv(bitstring,bitstring).  (* quote,gxy *)
event ServerStateEvKch(bitstring,ae_key).  (* quote,kch *)
event ServerStateEvKc(bitstring,ae_key).  (* quote,kc *)

event ServerID(identity,bitstring).  (* Server's ID and session key gxy *)
event ClientID(identity,bitstring).  (* Client's view of the Server's ID and session key gxy *)

(* Application Data Events *)
event ClientReceivesAppData(identity, pubkey, pubkey, pubkey, random, random, bitstring, bitstring, ae_key, ae_key, bitstring, bitstring).
event ServerSendsAppData(identity, pubkey, pubkey, pubkey, random, random, bitstring, bitstring, ae_key, ae_key, bitstring, bitstring).
(**********************************************************************)
(* Type Declarations *)
(**********************************************************************)
type sym_enc_key.   (*Symmetric encrption key*)
type sym_cipher.  (*Symmetric cipher/encrypted data*)

(**********************************************************************)
(* Declarations of functions, equational theories and rewrite rules *)
(**********************************************************************)
fun sym_enc(sym_enc_key,bitstring): sym_cipher.

(*Good practice to add function declaration for destructors also*)
(* Rewrite rule *)
fun sym_dec(sym_enc_key,sym_cipher): bitstring
reduc forall k:sym_enc_key, m:bitstring; 
  sym_dec(k,sym_enc(k,m)) = m.

fun b2s(bitstring): sym_enc_key [data].

free mesg:bitstring [private].

(**********************************************************************)
(* POST-HANDSHAKE AUTHENTICATOR & APPLICATION LAYER EXTENSIONS        *)
(**********************************************************************)

(********************************************************)
(*  TLS 1.3 Exporter Interface  *)
(********************************************************)

const exporter_label: label.  (* represents the fixed literal label "exporter" [Sec. 7.5, RFC9846] *)

letfun tls_exporter(exp_secret:bitstring, l:label, context_value:bitstring) =  (* 1st parameter is exporter_exp_secret [Sec. 7.5, RFC9846]; 2nd parameter is the caller's exporter label; 3rd parameter is the caller's context_value *)
  (* TLS-Exporter(label, context_value, key_length) = HKDF-Expand-Label(Derive-Secret(Secret, label, ""), "exporter", Hash(context_value), key_length) [Sec. 7.5, RFC9846] *)
  hkdf_expand_label(derive_secret(exp_secret,l,zero), exporter_label, hash(StrongHash,context_value)).

(********************************************************)
(* Exporter Labels & Post-Handshake Record Framing      *)
(********************************************************)
const ea_server_hs_context,  (* "EXPORTER-server authenticator handshake context" [RFC 9261] *)
  ea_server_fin_key,         (* "EXPORTER-server authenticator finished key" [RFC 9261] *)
  expat_attestation: label.  (* "Attestation" binder exporter label [draft-fossati-seat-expat] *)

(********************************************************)
(* EA-Specific Exporter Derivations                     *)
(********************************************************)

letfun ea_derive_hs_context(cb:bitstring) =  (* cb is the exporter_secret (ems) [Sec. 7.5, RFC9846]; context_value is empty for this exporter [Sec. 5.1, RFC9261] *)
  tls_exporter(cb, ea_server_hs_context, zero).

letfun ea_derive_fin_key(cb:bitstring) =  (* cb is the exporter_secret (ems) [Sec. 7.5, RFC9846]; context_value is empty for this exporter [Sec. 5.1, RFC9261] *)
  tls_exporter(cb, ea_server_fin_key, zero).

letfun ea_derive_attestation_binder(cb:bitstring, req_ctx:bitstring) =  (* cb is the exporter_secret (ems) [Sec. 7.5, RFC9846]; context_value is the certificate_request_context [Sec. 5.1, draft-fossati-seat-expat] *)
  tls_exporter(cb, expat_attestation, req_ctx).

(********************************************************)
(* Signature Domain Separation Context Strings          *)
(********************************************************)
const tls13_cv_context: bitstring [data].
const ea_cv_context: bitstring [data].

(**********************************************************************)
(* Application Data Record Layer                                      *)
(**********************************************************************)
fun ph_msg(bitstring, bitstring): bitstring.
reduc forall phdata:bitstring, k:bitstring;
  ph_read(ph_msg(phdata, k), k) = phdata.

fun ae2b(ae_key): bitstring [data, typeConverter].

(********************************************************)
(* ALTEA Transport Framing & Type Confusion Prevention  *)
(* Ref: draft-reddy-seat-expat-transport-01             *)
(********************************************************)
const ALTA_magic: bitstring [data].

type auth_msg_type.
const auth_request: auth_msg_type [data].
const authenticator: auth_msg_type [data].
const auth_error: auth_msg_type [data].
const auth_capabilities: auth_msg_type [data].

fun AuthFrame(bitstring, auth_msg_type, msg): bitstring [data].
fun App_type(bitstring, bitstring): bitstring [data].

fun AuthenticatorRequest(bitstring):msg [data].
fun AuthenticatorResponse(msg, msg, msg):msg [data].

(**********************************************************************)
(* Sanity Checks (Reachability props): should all be false (confirms event is reachable) *)
(**********************************************************************)
(* should be false (confirms event is reachable) *)
(* checks, for all terms ev, whether the event Accepted(ev) can occur. *)
query cr:random, sr:random, ID_S,ID_C:identity,
      psk:preSharedKey, pubAK,pubLTK:pubkey, e:element,
      offer:params, mode:params, ev,log,rdata:bitstring,
      kc:ae_key,ks:ae_key,ems:bitstring,rms:bitstring,
      idS, idXS: identity, gxy:bitstring;

(* should be false (confirms both events are reachable) 
i.e., there exists a trace where *both* ServerID and ClientID 
are reachable with a shared/common gxy *)
    (event(ServerID(idS,gxy)) &&
     event(ClientID(idXS,gxy)));

    event(Accepted(ev));
    event(Appraised(log));
    event(ClientConn(ev));
    event(ClientFinished(pubAK,psk,cr,sr,offer,mode,kc,ks,ems,rms));
    event(ClientFinRecentAgr(ID_S,ID_C,pubLTK,psk,offer,mode,kc,ks,ems,rms,cr,sr));
    event(ServerFinished(cr,sr,psk,pubLTK,offer,mode,kc,ks,ems,rms));
    event(AcceptedRdata(rdata))
.

(* should be false (confirms events are reachable) 
Goal: Events are reachable in the absence of an attacker.
  An honest execution path for these events exists without any weakness (e.g.,leakage). 
  Protocol can run without any attacker interference (exclude all weaknesses).
Formalization: ServerLastEvent && ClientLastEvent ==> All weaknesses
*)

query pubEK:pubkey,dev_state:bitstring,quote:bitstring,
      cr:random, sr:random, cr':random, sr':random,
      ID:identity,pubLTK:pubkey,pubAK:pubkey,anyAK:pubkey,
      psk:preSharedKey, e:element, pubCA,pubISV:pubkey,
      offer:params, mode:params, ID_S:identity,
      kc:ae_key,ks:ae_key,ems:bitstring,rms:bitstring;

  event(ClientFinished(pubEK,psk,cr,sr,offer,mode,kc,ks,ems,rms)) &&
  event(ServerFinished(cr,sr,psk,pubLTK,offer,mode,kc,ks,ems,rms)) ==>
  event(ClientAcceptsElement(cr, BadElement)) ||
  event(ClientAcceptsHash(cr, WeakHash)) ||
  event(SentBadElement) ||
  event(LeakedAK(pubAK)) ||
  event(LeakedEK(pubEK)) ||
  event(CompromisedCA(pubCA)) ||
  event(CompromisedCSP(pubISV))
;

(* ClientComp and ServerComp with more parameters of agreement *)
(* should be false (confirms events are reachable) *)
  event(ClientComp(ID_S,pubLTK,psk,offer,mode,kc,ks,ems,rms,cr,sr,pubEK,dev_state)) &&
  event(ServerComp(ID_S,pubLTK,psk,offer,mode,kc,ks,ems,cr,sr,pubEK,dev_state)) ==>
  event(ClientAcceptsElement(cr, BadElement)) ||
  event(ClientAcceptsHash(cr, WeakHash)) ||
  event(SentBadElement) ||
  event(LeakedAK(pubAK)) ||
  event(LeakedEK(pubEK)) ||
  event(CompromisedCA(pubCA)) ||
  event(CompromisedCSP(pubISV))
.

(**********************************************************************)
(* Binding and correlation queries *)
(**********************************************************************)

(* Reachability *)
query ev:bitstring,gxy:bitstring;
      event(ClientStateEv(ev,gxy)) &&
      event(ServerStateEv(ev,gxy))
.

query ev:bitstring,kch:ae_key;
      event(ClientStateEvKch(ev,kch)) &&
      event(ServerStateEvKch(ev,kch))
.

query ev:bitstring,kc:ae_key;
      event(ClientStateEvKc(ev,kc)) &&
      event(ServerStateEvKc(ev,kc))
.

(**********************************************************************)
(* Binding *)
(*
Goal G1: Binding Evidence to TLS session: Evidence should not be usable in
  other TLS sessions, even if they are between the same endpoints.
  (Not binding to endpoints because multiple sessions of endpoints are possible)
3 levels of binding to TLS session: 
  L1. gxy (gx,gy)
  L2. kch (up to ServerHello)
  L3. kc (up to ServerFinished): may include ID_S in Certificate message
  L1 <= L2 <= L3
Formalization: Same evidence is not accepted by two different TLS sessions.
  TLS session identified by gxy. Trace should not contain:
  Client(ev1,gxy1); Server(ev1,gxy2);
  (* Informal: If they see the same evidence, they should be in the same session *)
Parameters: Quote instead of dev_state
  ds = ev, gxy
  server identity not a part of the query because that is covered by G-C2
Events: 
  ServerStateEv after verifying CFin.
  Rationale: Both endpoints have accepted the connection with the same evidence. 
*)
query ev,ev1,ev2,gxy,gxy1,gxy2:bitstring, 
      kch,kch1,kch2,ks,kc,kc1,kc2:ae_key,
      cr,sr,cr',sr':random,ID1,ID2,ID:identity,
      pubAK,pubCA,pubEK,pubEK1,pubEK2,
      pubLTK,pubLTK1,pubLTK2:pubkey,e:element, 
      psk:preSharedKey,ems,rms:bitstring,
      dev_status,dev_status1,dev_status2:bitstring,
      req_ctx,app_msg:bitstring,
      offer:params, mode:params;
      event(ClientStateEv(ev,gxy1)) &&
      event(ServerStateEv(ev,gxy2)) ==>
      (gxy1 = gxy2)
;


(*
Goal G2: Binding to client_write_key (kch) derived from handshake traffic secret (htsc) 
Rationale: It has log_SH in addition to gxy
*)
      event(ClientStateEvKch(ev,kch1)) &&
      event(ServerStateEvKch(ev,kch2)) ==>
      (kch1 = kch2)
;

(* 
Goal G3: w.r.t. client_write_key (kc) for application data derived from client_application_traffic_secret_0 (atsc) 
Rationale: It has transcript hash up to log_SF (vs. log_SH in above property).
*)
      event(ClientStateEvKc(ev,kc1)) &&
      event(ServerStateEvKc(ev,kc2)) ==>
      (kc1 = kc2) || event(ClientID(ID, e2b(BadElement)))
;

(* 
Goal G3: w.r.t. client_write_key (kc) for application data derived from client_application_traffic_secret_0 (atsc) 
Rationale: It has transcript hash up to log_SF (vs. log_SH in above property).
Remove BadElement from Client gxy calculation to see counterexample for intra-
*)
      event(ClientStateEvKc(ev,kc1)) &&
      event(ServerStateEvKc(ev,kc2)) ==>
      (kc1 = kc2)
;

(* Full session with kc/ev correlated *)
    (
      event(ClientComp(ID1,pubLTK,psk,offer,mode,kc1,ks,ems,rms,cr,sr,pubEK,dev_status1)) &&
      event(ClientStateEvKc(ev1,kc1)) 
    )
        && (* Correlation *)
    (
      event(PreServerComp(ID2,pubLTK,psk,offer,mode,kc2,ks,ems,cr,sr,pubEK,dev_status2)) &&
      event(ServerStateEvKc(ev2,kc2))
    )
    ==> ((kc1,ev1) = (kc2,ev2)) || event(ClientID(ID, e2b(BadElement)))
;

(* Full session with kc/ev correlated 
   Remove BadElement from Client gxy calculation to see counterexample for post-
*)
    (
      event(ClientComp(ID1,pubLTK,psk,offer,mode,kc1,ks,ems,rms,cr,sr,pubEK,dev_status1)) &&
      event(ClientStateEvKc(ev1,kc1)) 
    )
        && (* Correlation *)
    (
      event(PreServerComp(ID2,pubLTK,psk,offer,mode,kc2,ks,ems,cr,sr,pubEK,dev_status2)) &&
      event(ServerStateEvKc(ev2,kc2))
    )
    ==> ((kc1,ev1) = (kc2,ev2))
.

(* Property G-TLS1: Server Identity property to protect against diversion attacks
Goal: If the client gets public identity of server from a given connection, then
  the identities match.
Events: ClientID is placed when Client is ready to establish connection (just before sending ClientFinished); 
  ServerID is placed in the beginning of Server process
Formalization:
  See manual page 54 https://bblanche.gitlabpages.inria.fr/proverif/manual.pdf
  event (e1(M1)) && event (e2(M2)) ==> H
  if events e1(M1) and e2(M2) are executed, then H holds.
  This formalization can sometimes find more attacks than traditional non-injective agreement
Details:
  cloud.example.com is ID of virtual machine (host) associated with EK.
*)

query idS,idXS:identity,pubLTK:pubkey,pubAK:pubkey,pubEK:pubkey,
  gxy:bitstring,
  cr:random, sr:random, cr':random, sr':random,
  psk:preSharedKey, p:pubkey, e:element,
  offer:params, mode:params, pubCA,pubISV:pubkey,
  kc:ae_key,ks:ae_key,ems:bitstring,rms:bitstring;  

(* Result: false (without CSP trust assumption)  *)
  (event(ServerID(idS,gxy)) &&
  event(ClientID(idXS,gxy))) ==>
  (idS = idXS) ||
  event(ClientAcceptsElement(cr, BadElement)) ||
  event(ClientAcceptsHash(cr, WeakHash)) ||
  event(SentBadElement) ||
  event(LeakedAK(pubAK))
;

(* Result: true (with CSP trust assumption)  *)
  (event(ServerID(idS,gxy)) &&
  event(ClientID(idXS,gxy))) ==>
  (idS = idXS) ||
  event(ClientAcceptsElement(cr, BadElement)) ||
  event(ClientAcceptsHash(cr, WeakHash)) ||
  event(SentBadElement) ||
  event(LeakedAK(pubAK)) ||
  event(CompromisedCSP(pubISV))
;

(* Result: false (without AK or CA trust assumption)  *)
  (event(ServerID(idS,gxy)) &&
  event(ClientID(idXS,gxy))) ==>
  (idS = idXS) ||
  event(ClientAcceptsElement(cr, BadElement)) ||
  event(ClientAcceptsHash(cr, WeakHash)) ||
  event(SentBadElement) ||
  event(LeakedEK(pubEK))
;

(* Result: true (with CA trust assumption, without AK)  *)
  (event(ServerID(idS,gxy)) &&
  event(ClientID(idXS,gxy))) ==>
  (idS = idXS) ||
  event(ClientAcceptsElement(cr, BadElement)) ||
  event(ClientAcceptsHash(cr, WeakHash)) ||
  event(SentBadElement) ||
  event(LeakedEK(pubEK)) ||
  event(CompromisedCA(pubCA))
.

(**********************************************************************)
(* Auxiliary Properties for G-RA2 *)
(* Goal: With evidence in parameters
Interpretation: unlike pre-HS, it holds (stronger security than pre-HS) *)

(* Result: true with secure AK (CA and TLS key compromised)  *)
query pubEK:pubkey,dev_state:bitstring, ev:bitstring,ID:identity,pubLTK:pubkey,pubAK:pubkey,
      cr,cr':random, sr,sr':random, e:element, pubCA,pubISV:pubkey;

(* Result: false (without CSP trust assumption)  *)
      event(ClientRA(pubAK,pubEK,dev_state,ev)) ==>
      inj-event(ServerRA(ID,pubLTK,pubAK,pubEK,dev_state,ev)) ||
      event(LeakedAK(pubAK)) 
;

(* Result: true (with CSP trust assumption)  *)
      event(ClientRA(pubAK,pubEK,dev_state,ev)) ==>
      inj-event(ServerRA(ID,pubLTK,pubAK,pubEK,dev_state,ev)) ||
      event(LeakedAK(pubAK)) ||
      event(CompromisedCSP(pubISV))
;

(* Result: false (without AK or CA trust assumption)  *)
      event(ClientRA(pubAK,pubEK,dev_state,ev)) ==>
      inj-event(ServerRA(ID,pubLTK,pubAK,pubEK,dev_state,ev)) ||
      event(ClientAcceptsElement(cr, BadElement)) ||
      event(ClientAcceptsHash(cr, WeakHash)) ||
      event(SentBadElement) ||
      event(LeakedEK(pubEK))
;

(* Result: true (with CA trust assumption, without AK)  *)
      event(ClientRA(pubAK,pubEK,dev_state,ev)) ==>
      inj-event(ServerRA(ID,pubLTK,pubAK,pubEK,dev_state,ev)) ||
      event(ClientAcceptsElement(cr, BadElement)) ||
      event(ClientAcceptsHash(cr, WeakHash)) ||
      event(SentBadElement) ||
      event(LeakedEK(pubEK)) ||
      event(CompromisedCA(pubCA))
.

(* 
Goal: Check freshness of attestation claims rather than whole evidence in G-RA2.
Events: AcceptedRdata is placed after verification of CertificateVerify (NOT after ServerFinished)
        Sent is placed just before sending the evidence
Interpretation of result: Per-session Evidence Freshness is provided by the protocol with additional assumptions
*)

query dev_state:bitstring, cr:random, sr:random, e:element,
      ID:identity,pubLTK:pubkey,pubAK:pubkey,pubEK:pubkey,pubCA,pubISV:pubkey;

(* Result: false (without CSP trust assumption)  *)
  inj-event(AcceptedRdata(dev_state)) ==>
  inj-event(SentRdata(dev_state)) ||
  event(LeakedAK(pubAK)) || 
  event(ServerChoosesKEX(cr,sr,DHE_13(WeakDH,e))) ||
  event(ServerChoosesHash(cr,sr,WeakHash))
;

(* Result: true (with CSP trust assumption)  *)
  inj-event(AcceptedRdata(dev_state)) ==>
  inj-event(SentRdata(dev_state)) ||
  event(LeakedAK(pubAK)) || 
  event(ServerChoosesKEX(cr,sr,DHE_13(WeakDH,e))) ||
  event(ServerChoosesHash(cr,sr,WeakHash)) ||
  event(CompromisedCSP(pubISV))
;

(* Result: false (without AK or CA trust assumption)  *)
  inj-event(AcceptedRdata(dev_state)) ==>
  inj-event(SentRdata(dev_state)) ||
  event(LeakedEK(pubEK)) ||
  event(ServerChoosesKEX(cr,sr,DHE_13(WeakDH,e))) ||
  event(ServerChoosesHash(cr,sr,WeakHash))
;

(* Result: true (with CA trust assumption, without AK)  *)
  inj-event(AcceptedRdata(dev_state)) ==>
  inj-event(SentRdata(dev_state)) ||
  event(LeakedEK(pubEK)) ||
  event(ServerChoosesKEX(cr,sr,DHE_13(WeakDH,e))) ||
  event(ServerChoosesHash(cr,sr,WeakHash)) ||
  event(CompromisedCA(pubCA))
.

(*
Goal: If the client finished the session with evidence ev, 
            it must have started with the server sending exactly the same evidence ev 
            as long as privAK is not leaked ...
Events: ClientConn is placed when Client is ready to establish connection (just before ClientFinished); 
        Sent is placed just before sending the evidence 
Method: tried different combinations to see the minimal set which makes it true
NOTE: Query is VERY heavy with post-handshake

query ev:bitstring, cr:random, sr:random, e:element,
      ID:identity,pubLTK:pubkey,pubAK:pubkey,pubEK:pubkey,pubCA,pubISV:pubkey;

(* Result: false (without CSP trust assumption)  *)
      inj-event(ClientConn(ev)) ==>
      inj-event(Sent(ev)) ||
      event(LeakedAK(pubAK)) ||
      event(ServerChoosesKEX(cr,sr,DHE_13(WeakDH,e))) ||
      event(ServerChoosesHash(cr,sr,WeakHash))
;

(* Result: true (with CSP trust assumption)  *)
      inj-event(ClientConn(ev)) ==>
      inj-event(Sent(ev)) ||
      event(LeakedAK(pubAK)) ||
      event(ServerChoosesKEX(cr,sr,DHE_13(WeakDH,e))) ||
      event(ServerChoosesHash(cr,sr,WeakHash)) ||
      event(CompromisedCSP(pubISV))
;


(* Result: false (without AK or CA trust assumption)  *)
      inj-event(ClientConn(ev)) ==>
      inj-event(Sent(ev)) ||
      event(LeakedEK(pubEK)) ||
      event(ServerChoosesKEX(cr,sr,DHE_13(WeakDH,e))) ||
      event(ServerChoosesHash(cr,sr,WeakHash))
;

(* Result: true (with CA trust assumption, without AK)  *)
      inj-event(ClientConn(ev)) ==>
      inj-event(Sent(ev)) ||
      event(LeakedEK(pubEK)) ||
      event(ServerChoosesKEX(cr,sr,DHE_13(WeakDH,e))) ||
      event(ServerChoosesHash(cr,sr,WeakHash)) ||
      event(CompromisedCA(pubCA))
.
 *)

(* Property G-TLS2: Server authentication property for MITM attacks
Property: If the client finished the session with TLS session parameters, 
            it must have started with the server having exactly the same TLS session parameters 
            as long as privAK is not leaked ...
Intuitively: Can we reach ClientFinished without a *matching* PreServerFinished with *matching* values?          
Events: ClientFinished is placed when Client is ready to establish connection (just before sending ClientFinished); 
        PreServerFinished is placed just before sending ServerFinished
Parameters of agreement: Machine identifier (ID_S) and others described below in each property
  PSK here is a constant (non-PSK mode of TLS)
  kc,ks,ems,rms represent "session keys" (the various secrets derived from the main secret)
    as defined in appendix F.1 of RFC 8446
  Agreement of pubAK and dev_state is not checked since agreement of TLS parameters.
Interpretation of result: Client is assured of the (machine) identity of Server.
*)

(*
G-TLS2d: Recent One-way injective agreement
Additional parameters to One-way injective agreement: cr,sr
Adds agreement over nonces *)

query cr:random, sr:random, cr':random, sr':random,
      ID_S:identity,pubLTK:pubkey,pubAK:pubkey,pubEK:pubkey,
      psk:preSharedKey, p:pubkey, e:element, pubCA,pubISV:pubkey,
      offer:params, mode:params, dev_state:bitstring,
      kc:ae_key,ks:ae_key,ems:bitstring,rms:bitstring;

(* Result: false (without CSP trust assumption)  *)     
      inj-event(ClientFinRecent1WayAgr(ID_S,pubLTK,psk,offer,mode,kc,ks,ems,rms,cr,sr)) ==>
      inj-event(PreServerFinRecent1WayAgr(ID_S,pubLTK,psk,offer,mode,kc,ks,ems,cr,sr)) ||
      event(ClientAcceptsElement(cr, BadElement)) ||
      event(ClientAcceptsHash(cr, WeakHash)) ||
      event(SentBadElement) ||
      event(LeakedAK(pubAK))
;

(* Result: still false with post-handshake (when CA and TLS key compromised) 
        see query below for validation for post-handshake *)      
      inj-event(ClientFinRecent1WayAgr(ID_S,pubLTK,psk,offer,mode,kc,ks,ems,rms,cr,sr)) ==>
      inj-event(PreServerFinRecent1WayAgr(ID_S,pubLTK,psk,offer,mode,kc,ks,ems,cr,sr)) ||
      event(ClientAcceptsElement(cr, BadElement)) ||
      event(ClientAcceptsHash(cr, WeakHash)) ||
      event(SentBadElement) ||
      event(LeakedAK(pubAK)) ||
      event(CompromisedCSP(pubISV))
;

(* Result: true with secure AK and trusted CSP (verifying the post-handshake authenticator 
   binds the client to the legitimate server's initial TLS handshake without CA trust) *)
      inj-event(ClientFinishedWithID(ID_S,pubLTK,pubAK,psk,cr,sr,offer,mode,kc,ks,ems,rms)) ==>
      inj-event(PreServerFinRecent1WayAgr(ID_S,pubLTK,psk,offer,mode,kc,ks,ems,cr,sr)) ||
      event(ClientAcceptsElement(cr, BadElement)) ||
      event(ClientAcceptsHash(cr, WeakHash)) ||
      event(SentBadElement) ||
      event(LeakedAK(pubAK)) ||
      event(CompromisedCSP(pubISV))
;

(* Result: false (without AK or CA trust assumption)  *)
      inj-event(ClientFinRecent1WayAgr(ID_S,pubLTK,psk,offer,mode,kc,ks,ems,rms,cr,sr)) ==>
      inj-event(PreServerFinRecent1WayAgr(ID_S,pubLTK,psk,offer,mode,kc,ks,ems,cr,sr)) ||
      event(ClientAcceptsElement(cr, BadElement)) ||
      event(ClientAcceptsHash(cr, WeakHash)) ||
      event(SentBadElement) ||
      event(LeakedEK(pubEK))
;

(* Result: true (with CA trust assumption, without AK)  *)
      inj-event(ClientFinRecent1WayAgr(ID_S,pubLTK,psk,offer,mode,kc,ks,ems,rms,cr,sr)) ==>
      inj-event(PreServerFinRecent1WayAgr(ID_S,pubLTK,psk,offer,mode,kc,ks,ems,cr,sr)) ||
      event(ClientAcceptsElement(cr, BadElement)) ||
      event(ClientAcceptsHash(cr, WeakHash)) ||
      event(SentBadElement) ||
      event(LeakedEK(pubEK)) ||
      event(CompromisedCA(pubCA))
.

(**********************************************************************)
(* Agreement of composition (RA + TLS) parameters *)
(**********************************************************************)
(* Property G-C2: Composition Property for Relay attack
Goal: If the client finished the session with RA and TLS session parameters, 
            it must have started with the server having exactly the same RA and TLS session parameters 
            as long as privAK is not leaked ...
Events: ClientComp is placed when Client is ready to establish connection (just before sending ClientFinished); 
        PreServerComp is placed just before sending ServerFinished
Parameters of agreement: Combines the parameters of agreement from RA property (G-RA) and TLS property (G-TLS)
*)
query pubEK:pubkey,dev_state,dev_state1,dev_state2:bitstring,quote:bitstring,
      cr:random, sr:random, cr':random, sr':random,
      ID:identity,pubLTK:pubkey,pubAK:pubkey,
      psk:preSharedKey, e:element, pubCA,pubISV:pubkey,
      offer:params, mode:params, ID_S:identity,
      kc:ae_key,ks:ae_key,ems:bitstring,rms:bitstring;

(* Result: false (without CSP trust assumption)  *)     
      inj-event(ClientComp(ID_S,pubLTK,psk,offer,mode,kc,ks,ems,rms,cr,sr,pubEK,dev_state)) ==>
      inj-event(PreServerComp(ID_S,pubLTK,psk,offer,mode,kc,ks,ems,cr,sr,pubEK,dev_state)) ||
      event(ClientAcceptsElement(cr, BadElement)) ||
      event(ClientAcceptsHash(cr, WeakHash)) ||
      event(LeakedAK(pubAK))
;

(* Result: true (with CSP trust assumption)  *)
      inj-event(ClientComp(ID_S,pubLTK,psk,offer,mode,kc,ks,ems,rms,cr,sr,pubEK,dev_state)) ==>
      inj-event(PreServerComp(ID_S,pubLTK,psk,offer,mode,kc,ks,ems,cr,sr,pubEK,dev_state)) ||
      event(ClientAcceptsElement(cr, BadElement)) ||
      event(ClientAcceptsHash(cr, WeakHash)) ||
      event(LeakedAK(pubAK)) ||
      event(CompromisedCSP(pubISV))
;

(* Result: false (without CA trust assumption)  *)
      inj-event(ClientComp(ID_S,pubLTK,psk,offer,mode,kc,ks,ems,rms,cr,sr,pubEK,dev_state)) ==>
      inj-event(PreServerComp(ID_S,pubLTK,psk,offer,mode,kc,ks,ems,cr,sr,pubEK,dev_state)) ||
      event(ClientAcceptsElement(cr, BadElement)) ||
      event(ClientAcceptsHash(cr, WeakHash)) ||
      event(LeakedEK(pubEK))
;

(* Result: true (with CA trust assumption, without AK)  *)
      inj-event(ClientComp(ID_S,pubLTK,psk,offer,mode,kc,ks,ems,rms,cr,sr,pubEK,dev_state)) ==>
      inj-event(PreServerComp(ID_S,pubLTK,psk,offer,mode,kc,ks,ems,cr,sr,pubEK,dev_state)) ||
      event(ClientAcceptsElement(cr, BadElement)) ||
      event(ClientAcceptsHash(cr, WeakHash)) ||
      event(LeakedEK(pubEK)) ||
      event(CompromisedCA(pubCA))
.

(* 
Goal: The only way an attacker can know kc used by the client is that some compromise has happened. 
Formalization: 
  Need for "&& ClientFinished": It binds the attacker knows the specific key that the client 
  has accepted and is going to use in communication. This excludes other time points in the
  protocol when the handshake has not yet completed. 
Result: true
*)

query pubEK:pubkey,dev_status,dev_status1,dev_status2:bitstring,quote:bitstring,
      cr:random, sr:random, cr':random, sr':random,
      ID:identity,pubLTK:pubkey,pubAK:pubkey, ev: bitstring,
      psk:preSharedKey, e:element, pubCA,pubISV:pubkey,
      offer:params, mode:params, ID_S:identity,
      kc:ae_key,ks:ae_key,ems:bitstring,rms:bitstring;

(* Result: false (without CSP trust assumption)  *)     
  attacker(kc) && 
  (    (* Key Secrecy *)
       event(ClientRANew(NULL_ID,NULL_pubkey,pubAK,pubEK,dev_status1,ev))
    && event(ClientFin1WayAgr(ID,pubLTK,psk,offer,mode,kc,ks,ems,rms))
    && event(ClientStateEvKc(ev,kc))
  ) 
   ==> event(LeakedAK(pubAK))
    || event(ClientAcceptsElement(cr, BadElement))
    || event(ClientAcceptsHash(cr, WeakHash)) 
;  

(* Result: true (with CSP trust assumption)  *)
  attacker(kc) && 
  (    (* Key Secrecy *)
       event(ClientRANew(NULL_ID,NULL_pubkey,pubAK,pubEK,dev_status1,ev))
    && event(ClientFin1WayAgr(ID,pubLTK,psk,offer,mode,kc,ks,ems,rms))
    && event(ClientStateEvKc(ev,kc))
  ) 
   ==> event(LeakedAK(pubAK))
    || event(ClientAcceptsElement(cr, BadElement))
    || event(ClientAcceptsHash(cr, WeakHash)) 
    || event(CompromisedCSP(pubISV))
;     

(* Result: false (without CA trust assumption)  *)
  attacker(kc) && 
  (    (* Key Secrecy *)
       event(ClientRANew(NULL_ID,NULL_pubkey,pubAK,pubEK,dev_status1,ev))
    && event(ClientFin1WayAgr(ID,pubLTK,psk,offer,mode,kc,ks,ems,rms))
    && event(ClientStateEvKc(ev,kc))
  ) 
   ==> event(LeakedEK(pubEK)) 
    || event(ClientAcceptsElement(cr, BadElement))
    || event(ClientAcceptsHash(cr, WeakHash)) 
;

(* Result: true (with CA trust assumption, without AK)  *)
  attacker(kc) && 
  (    (* Key Secrecy *)
       event(ClientRANew(NULL_ID,NULL_pubkey,pubAK,pubEK,dev_status1,ev))
    && event(ClientFin1WayAgr(ID,pubLTK,psk,offer,mode,kc,ks,ems,rms))
    && event(ClientStateEvKc(ev,kc))
  ) 
   ==> event(LeakedEK(pubEK)) 
      || event(ClientAcceptsElement(cr, BadElement))
      || event(ClientAcceptsHash(cr, WeakHash)) 
      || event(CompromisedCA(pubCA))
.

(********************************************************)
(* Client Authenticator Process                         *)
(********************************************************)

let Client_EA(ID_C: identity, ID_S: identity, pubEK: pubkey, pubISV:pubkey, psk: preSharedKey, 
    cr: random, sr: random, offer: params, mode: params, gxy: bitstring, kch: ae_key, 
    ks: ae_key, kc: ae_key, ems: bitstring, rms: bitstring, shash_algo: hash_alg) = 
(
  new req_ctx: bitstring;  (* generate fresh certificate_request_context [Sec. 4, RFC9261] *)
  let req_msg = AuthenticatorRequest(req_ctx) in
  out(io, AuthFrame(ALTA_magic, auth_request, req_msg));  (* send Authenticator Request inside Shim Mode AuthFrame [Sec. 7, ALTEA] *)

  in(io, (ea_frame: bitstring));  (* receive Authenticator message wrapped in AuthFrame [Sec. 7, ALTEA] *)
  let AuthFrame(=ALTA_magic, =authenticator, ea_bundle) = ea_frame in (* enforce ALTA magic value and authenticator msg type *)
  let AuthenticatorResponse(CRT(ea_cert), CV(ea_sg), FIN(ea_mac)) = ea_bundle in  (* pattern-match components: Certificate, CertificateVerify, and Finished [Sec. 3.4, ALTEA] *)

  (* Certificate carries ephemeral key pubEK + attestation evidence *)
  let (selfcert: bitstring, selfsign: bitstring) = ea_cert in  (* pattern match ea_cert *)
  let (=pubEK, quote: bitstring) = selfcert in (* check selfsign format *)
  let (dataSign:bitstring, sig:bitstring) = quote in  (* check quote format *)
  let (rdata:bitstring, dev_status1:bitstring) = dataSign in  (* check dataSign format *)

  (* Pull in endorsements and compare to pubISV *)
  in(io, endorsements:bitstring); 
  let (platform_info:bitstring, sig2:bitstring) = endorsements in 
  let (pubAK:pubkey,dev_statusRef:bitstring) = platform_info in
  if verify(pubISV,platform_info,sig2) = true then

  if verify(pubAK,dataSign,sig) = true then  (* check signatures on Quote *)
  if dev_status1 = dev_statusRef then (* check measurements against Ref. Values *)

  (* verify binding between the TLS Authenticator Identity Key (pubEK) and Attestation Evidence *)
  let exported_val = ea_derive_attestation_binder(ems, req_ctx) in  (* derive exported key material using exporter_secret (ems) and req_ctx as context_value [Sec. 7.5, RFC9846; Sec. 5.1, draft-fossati-seat-expat] *)
  if rdata = (exported_val,pubEK) then

  let ea_hs_ctx = ea_derive_hs_context(ems) in  (* derive Authenticator Handshake Context using label "EXPORTER-server authenticator handshake context" [Sec. 5.1, RFC9261] *)
  let log_EA_CRT = (ea_hs_ctx, req_msg, CRT(ea_cert)) in  (* after this step, log_EA_CRT contains ea_hs_ctx || Authenticator Request || Certificate [Sec. 5.2.2, RFC9261] *)

  if verify(pubEK, hash(shash_algo, (ea_cv_context, log_EA_CRT)), ea_sg) = true then  (* verify CertificateVerify signature over Authenticator transcript hash using pubEK [Sec. 5.2.2, RFC9261] *)
  (
    event Accepted(quote);
    event Appraised(log_EA_CRT);
    event AcceptedRdata(dev_status1);
    event AcceptedWithPubEK(quote,pubEK);
    let log_EA_CV = (log_EA_CRT, CV(ea_sg)) in  (* after this step, log_EA_CV contains ea_hs_ctx || Authenticator Request || Certificate || CertificateVerify *)
    
    let ea_fin = ea_derive_fin_key(ems) in  (* derive Authenticator Finished Key using label "EXPORTER-server authenticator finished key" [Sec. 5.1, RFC9261] *)
    if ea_mac = hmac(StrongHash, b2mk(ea_fin), log_EA_CV) then  (* verify Authenticator Finished HMAC over log_EA_CV using key derived from ea_fin [Sec. 5.2.3, RFC9261] *)
    (
    let pubLTK = pubEK in (* pubLTK is pubEK for backward compat. with legacy queries *)
    event ClientFinishedWithID(ID_S,pubLTK,pubAK,psk,cr,sr,offer,mode,kc,ks,ems,rms);
    event ClientFinishedWithBothPub(pubAK,psk,pubEK,cr,sr,offer,mode,kc,ks,ems,rms);
    event ClientConn(quote);
    event ClientComp(ID_S,pubLTK,psk,offer,mode,kc,ks,ems,rms,cr,sr,pubEK,dev_status1);
    event ClientRA(pubAK,pubEK,dev_status1,quote);
    event ClientRA2(pubAK,pubEK,dev_status1);
    event ClientRA3(pubAK,pubEK,dev_status1,ID_C);
    event ClientRAWithoutAK(pubEK,dev_status1,quote);    
    event ClientRANew(NULL_ID,NULL_pubkey,pubAK,pubEK,dev_status1,quote);
    event ClientID(ID_S,gxy);
    event ClientStateEvKc(quote,kc);    
    event ClientStateEvKch(quote,kch);
    event ClientStateEv(quote,gxy);
    event ClientFinished(pubEK,psk,cr,sr,offer,mode,kc,ks,ems,rms);

      in(io, (app_msg_enc:bitstring));  (* receive post-handshake encrypted application message *)
      let app_msg_s = ph_read(app_msg_enc, ae2b(ks)) in  (* decrypt and verify AEAD application record using server write key ks *)
      event ClientReceivesAppData(ID_S,pubLTK,pubEK,pubAK,cr,sr,req_ctx,ems,ks,kc,dev_status1,app_msg_s)
    )
  )
).

(********************************************************)
(* Server Authenticator                                 *)
(********************************************************)

let Server_EA(server_cert: bitstring, ID_S: identity, privEK: privkey, privAK: privkey, 
    psk: preSharedKey, cr: random, sr: random, offer: params, mode: params, 
    gxy: bitstring, kch: ae_key, ks: ae_key, kc: ae_key, ems: bitstring, rms: bitstring, hash_algo: hash_alg) =
(
  in(io, req_frame: bitstring) [precise];  (* receive Authenticator Request frame from Client [Sec. 7, ALTEA] *)
  let AuthFrame(=ALTA_magic, =auth_request, req_msg) = req_frame in (* enforce ALTA magic value and auth_request msg type *)
  let AuthenticatorRequest(req_ctx) = req_msg in  (* pattern-match to extract certificate_request_context and encapsulated challenge secret *)

  let pubEK = pk(privEK) in 
  let pubLTK = pk(privEK) in (* pubLTK is pubEK for backward compat. with legacy queries *)
  let pubAK = pk(privAK) in

  (* Evidence generation *)
  (* model of dev_status (measurements): input from adversary *)
  (* Lets the adversary instantiate any desired VM 
      but only the one with correct measurements will be accepted at Verifier *)
  (* Alternative model: generate using new, give to adversary and use tables to store *)
    in(io, dev_status1: bitstring) [precise];

  (* RFC 9261 Authenticator Construction *)
  let exported_val = ea_derive_attestation_binder(ems, req_ctx) in  (* derive exported key material using exporter_secret (ems) and req_ctx as context_value [Sec. 7.5, RFC9846; Sec. 5.1, draft-fossati-seat-expat] *)
  let rdata = (exported_val,pubEK) in

  let dataSign = (rdata,dev_status1) in
  let quote = (dataSign, sign(privAK,dataSign)) in

  let selfsign = sign(privEK,(pubEK,quote)) in   
  let ea_cert = ((pubEK,quote),selfsign) in

  let ea_hs_ctx = ea_derive_hs_context(ems) in  (* derive Authenticator Handshake Context using label "EXPORTER-server authenticator handshake context" [Sec. 5.1, RFC9261] *)
  let log_EA_CRT = (ea_hs_ctx, req_msg, CRT(ea_cert)) in  (* construct Authenticator transcript log containing ea_hs_ctx || Authenticator Request || Certificate [Sec. 5.2.2, RFC9261] *)

  let ea_sg = sign(privEK, hash(hash_algo, (ea_cv_context, log_EA_CRT))) in  (* sign Authenticator transcript hash using ephemeral private key privEK [Sec. 5.2.2, RFC9261] *)
  let log_EA_CV = (log_EA_CRT, CV(ea_sg)) in  (* construct Authenticator transcript log containing log_EA_CRT || CertificateVerify *)

  let ea_fin = ea_derive_fin_key(ems) in  (* derive Authenticator Finished Key using label "EXPORTER-server authenticator finished key" [Sec. 5.1, RFC9261] *)
  let ea_mac = hmac(StrongHash, b2mk(ea_fin), log_EA_CV) in  (* compute Authenticator Finished HMAC over log_EA_CV using ea_fin key [Sec. 5.2.3, RFC9261] *)

  event Conveyed(log_EA_CRT);
  event Sent(quote);
  event SentWithPubEK(quote,pubEK);
  event SentRdata(dev_status1);
  event ServerRA(ID_S,pubLTK,pubAK,pubEK,dev_status1,quote);  
  event ServerRA2(pubAK,pubEK,dev_status1);
  event ServerRAWithoutAK(pubEK,dev_status1,quote);

  event PreServerFinishedWithID(ID_S,pubLTK,pubAK,psk,cr,sr,offer,mode,kc,ks,ems);
  event PreServerFinishedWithBothPub(pubAK,psk,pubEK,cr,sr,offer,mode,kc,ks,ems);
  event PreServerComp(ID_S,pubLTK,psk,offer,mode,kc,ks,ems,cr,sr,pubEK,dev_status1);
  event ServerComp(ID_S,pubLTK,psk,offer,mode,kc,ks,ems,cr,sr,pubEK,dev_status1);

  event ServerStateEvKc(quote,kc);
  event ServerStateEvKch(quote,kch);
  event ServerStateEv(quote,gxy);

  let ea_bundle = AuthenticatorResponse(CRT(ea_cert), CV(ea_sg), FIN(ea_mac)) in
  out(io, AuthFrame(ALTA_magic, authenticator, ea_bundle));  (* send Authenticator message bundle inside Shim Mode AuthFrame [Sec. 7, ALTEA] *)

  new app_msg: bitstring;  (* generate fresh application payload *)
  event ServerSendsAppData(ID_S,pubLTK,pubEK,pubAK,cr,sr,req_ctx,ems,ks,kc,dev_status1,app_msg);
  out(io, ph_msg(app_msg, ae2b(ks)))  (* encrypt and transmit post-handshake record with server application write key ks *)
).

(********************************************************)
(* Client *)
(********************************************************)
(* (for usability/extensibility), we can use variables for messages, 
e.g., SH so that these variables can then be used in logs *)

let Client(ID_C:identity,ID_S:identity,pubISV:pubkey,pubCA:pubkey) =
(
  in(io, ioffer:params);  (* io is a public channel. ioffer is obtained from adversary as input to allow adversary to generate all valid patterns *)
  let nego(=aTLS,DHE_13(g,eee),hash_algo,ev_type) = ioffer in
  (* Message parsing modeled as a pattern-match with the constructors [Bhargavan2017; p. 17] *)

  let (x:bitstring, gx:element) = dh_keygen(g) in
  (* (x,gx) returned by dh_keygen for a given group g and freshly generated x; see def. above in the same file *)
  let offer = nego(aTLS,DHE_13(g,gx),hash_algo,ev_type) in
  (* Note that we really need DHE_13(g,gx) *)

  new cr:random;  (* random nonce: ClientHello.random; 8446bis page 10 *)
  let ch = CH(cr,offer,ID_S) in
  let psk = NoPSK in (* non-PSK handshake, so use NoPSK to get zero. *)
  let (es:bitstring,kb:mac_key,kc0:ae_key,ems0:bitstring) = kdf_es(psk,msg2bytes(ch)) in  (* non-PSK handshake, so use NoPSK to get zero. log1 is simply ch *)
  (* If a given secret is not available, then the 0-value consisting of a string of Hash.length bytes set to zeros is used.
  Note that this does not mean skipping rounds, so if PSK is not in use, Early Secret will still be HKDF-Extract(0, 0). [Section 7.1, RFC8446]  *)
  event ClientOffersHash(cr,hash_algo); (*hash algorithm used for HKDF [Table 4 in Appendix B.4 8446bis]*)
  event ClientOffersKEX(cr,DHE_13(g,gx));  (* supported_groups: which (EC)DHE groups client supports; and key_share extensions: (EC)DHE shares for some or all of these groups: [sec. 4.1.1. in 8446]; DH Key exchange groups [Schwenk2022 p.253] *)
  event ClientOffersEvType(cr,ev_type);
  out(io, ch);  (* send ClientHello message *)

  in(io, SH(sr,mode));  (* Receive ServerHello *)
  let nego(=aTLS,DHE_13(=g,gy),shash_algo,sev_type) = mode in  (* pattern matching to ensure that received mode is in the desired format and is in the same group g as sent *)
  event ClientAcceptsElement(cr, gy); (* Capture degenerate keyshares / BadElement *)
  event ClientAcceptsHash(cr, shash_algo); (* Capture TLS 1.2 downgrade attack *)
  let log_SH = (ch,SH(sr,mode)) in  (* after this step, log_SH contains sent ClientHello || received ServerHello *)

  let gxy = e2b(dh_exp(g,gy,x)) in  (* represents (EC)DHE in Key Derivation [Sec. 7.1, RFC8446] *)
  let (hs:bitstring,kch:ae_key,ksh:ae_key,kcm:mac_key,ksm:mac_key) = kdf_hs(es,gxy,log_SH) in
  in(io,CRT(server_cert));  (* receive Certificate message (Note: =ID_S can be removed) *)
  let (id_pub_pair:bitstring, sig1:bitstring) = server_cert in  (* check server_cert format *)
  let (=ID_S,pubEK:pubkey) = id_pub_pair in  (* check signed data format *)
  if verify(pubCA,id_pub_pair,sig1) = true then  (* check signatures on server_cert *)

  let log_CRT = (log_SH,CRT(server_cert)) in  (* after this step, log_CRT contains sent ClientHello || received ServerHello || received Certificate *)

  in(io,CV(sg));  (* receive CertificateVerify message *)
  if verify(pubEK,hash(shash_algo,log_CRT),sg) = true then  (* log_CRT contains msgs up to Certificate *)
  let log_CV = (log_CRT,CV(sg)) in  (* after this step, log_CV contains sent ClientHello || received ServerHello || received Certificate || received CertificateVerify *)

  in(io,FIN(m1));  (* receive server Finished message containing hmac of log *)
  if m1 = hmac(StrongHash,ksm,log_CV) then    (* hmac(hash_alg,mac_key,bitstring); mac_key = ksm using Client's perspective of log_CV; that's why client needs to generate server keys also *)
  (
    let log_SFIN = (log_CV,FIN(m1)) in  (* after this step, log_SFIN contains sent ClientHello || received ServerHello || received Certificate || received CertificateVerify || received server Finished *)
    let (ms:bitstring,kc:ae_key,ks:ae_key,ems:bitstring) = kdf_ms(hs,log_SFIN) in
    let m2 = hmac(StrongHash,kcm,log_SFIN) in  (* hmac(hash_alg,mac_key,bitstring); mac_key = kcm *)
    let log_CFIN = (log_SFIN,FIN(m2)) in  (* after this step, log_CFIN contains sent ClientHello || received ServerHello || received Certificate || received CertificateVerify || received server Finished || sent client Finished *)
    let rms =  kdf_psk(ms,log_CFIN) in

    let pubLTK = pubEK in (* pubLTK is pubEK for backward compat. with legacy queries *)
    event ClientFinishedAliveness(ID_S);
    event ClientFinishedWeakAgr(ID_S,ID_C);
    event ClientFinAgr(ID_S,ID_C,pubLTK,psk,offer,mode,kc,ks,ems,rms);
    event ClientFin1WayAgr(ID_S,pubLTK,psk,offer,mode,kc,ks,ems,rms);
    event ClientFinRecent1WayAgr(ID_S,pubLTK,psk,offer,mode,kc,ks,ems,rms,cr,sr);
    event ClientFinRecentAgr(ID_S,ID_C,pubLTK,psk,offer,mode,kc,ks,ems,rms,cr,sr);
    event ClientFinished(pubEK,psk,cr,sr,offer,mode,kc,ks,ems,rms);
    (* insert clientSession(cr,sr,psk,offer,mode,kc,ks,ems,rms);  kc and ks are passed to appData via this table *)
    out(io,FIN(m2));  (* send ClientFinished message *)

    (* continue from TLS handshake into Exported Authenticator handshake *)
    Client_EA(ID_C,ID_S,pubEK,pubISV,psk,cr,sr,offer,mode,gxy,kch,ks,kc,ems,rms,shash_algo)
  )
).

(********************************************************)
(* Server *)
(********************************************************)

let Server(ID_S:identity, privAK: privkey, privEK: privkey, server_cert:bitstring) =
(
  in(io, ch:msg); (* Receive ClientHello message from Client and store in variable ch *)
  let CH(cr,offer,sni) = ch in (* pattern matching to ensure that received message in variable ch is in the desired format fun CH(random,params,random):msg [data]. nonce will be stored in variable cr and parameters will be stored in variable offer. Attestation nonce will be stored in ar *)
  let nego(=aTLS,DHE_13(g,gx),xhash_algo,xev_type) = offer in (* pattern matching to ensure that received message in variable offer is in the desired format fun nego(tls_typ,kex_alg,hash_alg,ev_typ): params [data]. *)
  let psk = NoPSK in (* non-PSK handshake, so use NoPSK to get zero. *)
  let (es:bitstring,kb:mac_key,kc0:ae_key,ems0:bitstring) = kdf_es(psk,msg2bytes(ch)) in  (* non-PSK handshake, so use NoPSK to get zero. log1 is simply ch *)

  new sr:random; (* Server nonce used in "SH" below *)
  (* instead of SH as input in original *)
  in(io, smode:params);  (* io is a public channel. It is obtained from adversary as input to allow adversary to generate all valid modes *)
  let nego(=aTLS,DHE_13(=g,eee),hash_algo,ev_type) = smode in (* check format of smode and ensure that group matches the group g as in ClientHello message *)

  let (y:bitstring,gy:element) = dh_keygen(g) in
  (* (y,gy) returned by dh_keygen for a given group g and freshly generated y; see def. above in the same file *)
  let mode = nego(aTLS,DHE_13(g,gy),hash_algo,ev_type) in  (* Server selects a mode that fixes the group and all other session parameters [Bhargavan2017; p.16] *)
  out(io,SH(sr,mode));  (* Send ServerHello containing server nonce and selected mode *)
  let log_SH = (ch,SH(sr,mode)) in  (* received ClientHello || sent ServerHello *)
  event ServerChoosesKEX(cr,sr,DHE_13(g,gy));  (* DHKE group *)
  event ServerChoosesHash(cr,sr,hash_algo);  (* hash algorithm used for HKDF/transcript hash [Table 4 in Appendix B.4 8446bis] *)
  event ServerChoosesATLS(cr,sr,aTLS); (* Standard or Attested TLS *)
  event ServerChoosesEvType(cr,sr,ev_type);  (* Evidence type *)

  let gxy = e2b(dh_exp(g,gx,y)) in  (* represents (EC)DHE in Key Derivation [Sec. 7.1, RFC8446] *)
  let (hs:bitstring,kch:ae_key,ksh:ae_key,kcm:mac_key,ksm:mac_key) = kdf_hs(es,gxy,log_SH) in

  let pubEK = pk(privEK) in
  let pubLTK =pk(privEK) in (* pubLTK is pubEK for backward compat. with legacy queries *)
  let pubAK = pk(privAK) in
  event ServerID(ID_S,gxy);

  out(io,CRT(server_cert));  (* Send Certificate message *)
  let log_CRT = (log_SH,CRT(server_cert)) in  (* received ClientHello || sent ServerHello || sent Certificate *)

  (* CertificateVerify message *)
  let sg     = sign(privEK ,hash(hash_algo,log_CRT)) in  (* A signature over the value Transcript-Hash(Handshake Context, Certificate) [Sec. 4.4, RFC8446] using LTK; Handshake Context via first row of table in Sec. 4.4 of RFC8446. log_CRT contains Handshake Context, Certificate. *)
  out(io,CV(sg));  (* Send CertificateVerify message *)
  let log_CV = (log_CRT,CV(sg)) in  (* received ClientHello || sent ServerHello || sent Certificate || sent CertificateVerify *)

  (* serverFinished message *)
  let m1 = hmac(StrongHash,ksm,log_CV) in  (* A MAC over the value Transcript-Hash(Handshake Context, Certificate, CertificateVerify) using a MAC key derived from the Base Key [Sec. 4.4, RFC8446]. Handshake Context via first row of table in Sec. 4.4 of RFC8446. log_CV contains Handshake Context, Certificate, CertificateVerify  *)
  let log_SFIN = (log_CV,FIN(m1)) in  (* received ClientHello || sent ServerHello || sent Certificate || sent CertificateVerify || sent ServerFinished *)
  let (ms:bitstring,kc:ae_key,ks:ae_key,ems:bitstring) = kdf_ms(hs,log_SFIN) in  (* Key Derivation [Sec. 7.1, RFC8446] *)
  let ID_C = NULL_ID in (* One way auth only *)
  event PreServerFinished(pubEK,psk,cr,sr,offer,mode,kc,ks,ems);
  event PreServerFinishedAliveness(ID_S);
  event PreServerFinishedWeakAgr(ID_S,ID_C);
  event PreServerFin1WayAgr(ID_S,pubLTK,psk,offer,mode,kc,ks,ems);
  event PreServerFinRecent1WayAgr(ID_S,pubLTK,psk,offer,mode,kc,ks,ems,cr,sr);  
  event PreServerFinAgr(ID_S,ID_C,pubLTK,psk,offer,mode,kc,ks,ems);
  event PreServerFinRecentAgr(ID_S,ID_C,pubLTK,psk,offer,mode,kc,ks,ems,cr,sr);
  out(io,FIN(m1));  (* Send serverFinished message *)

  (* clientFinished message *)
  in(io,FIN(m2));  (* Receive client Finished message *)
  if m2 = hmac(StrongHash,kcm,log_SFIN) then  (* kcm represents kcm; check mac of finished from client *)
    let log_CFIN = (log_SFIN,FIN(m2)) in  (* received ClientHello || sent ServerHello || sent Certificate || sent CertificateVerify || sent ServerFinished || received ClientFinished *)
	let rms =  kdf_psk(ms,log_CFIN) in
    event ServerFinished(cr,sr,psk,pubLTK,offer,mode,kc,ks,ems,rms);

    (* continue from TLS handshake into Exported Authenticator handshake *)
    Server_EA(server_cert,ID_S,privEK,privAK,psk,cr,sr,offer,mode,gxy,kch,ks,kc,ems,rms,hash_algo)
).
